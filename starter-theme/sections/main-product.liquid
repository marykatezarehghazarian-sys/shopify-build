{%- assign current = product.selected_or_first_available_variant -%}
<div class="page-width product">
  <div class="product__media">
    {%- for media in product.media -%}
      {{ media | image_url: width: 1200 | image_tag: widths: '600,900,1200', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endfor -%}
  </div>
  <div class="product__info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'title' -%}<h1 {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
        {%- when 'price' -%}<div {{ block.shopify_attributes }}>{% render 'price', product: product, variant: current %}</div>
        {%- when 'description' -%}<div {{ block.shopify_attributes }}>{{ product.description }}</div>
        {%- when 'buy_buttons' -%}
          {%- form 'product', product, data-product-form: '' -%}
            <input type="hidden" name="id" value="{{ current.id }}">
            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                <label>{{ option.name }}
                  <select data-option>
                    {%- for value in option.values -%}<option {% if value.selected %}selected{% endif %}>{{ value }}</option>{%- endfor -%}
                  </select>
                </label>
              {%- endfor -%}
            {%- endunless -%}
            <script type="application/json" data-variants>{{ product.variants | json }}</script>
            <p><input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.quantity' | t }}"></p>
            <button class="button" type="submit" {% unless current.available %}disabled{% endunless %}>{{ 'products.add_to_cart' | t }}</button>
          {%- endform -%}
        {%- when '@app' -%}{% render block %}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Product information",
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1 }
  ]
}
{% endschema %}

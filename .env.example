# Your store's myshopify domain (not the custom domain)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API access token from a custom app (starts with shpat_)
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

# Admin API version (quarterly: YYYY-01/04/07/10)
SHOPIFY_API_VERSION=2026-07

# Theme Access app password, used by `shopify theme` commands (starts with shptka_)
SHOPIFY_CLI_THEME_TOKEN=shptka_xxxxxxxxxxxxxxxxxxxxxxxx

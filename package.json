{
  "name": "shopify-build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shopify theme development + Admin API tooling",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "shop": "bin/shop.js",
    "client": "bin/client.js"
  },
  "scripts": {
    "client": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA bin/client.js",
    "shop": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA bin/shop.js",
    "theme": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA bin/theme.js",
    "check:env": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA bin/shop.js shop:info",
    "theme:check-starter": "shopify theme check --path starter-theme",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@shopify/cli": "^3"
  }
}

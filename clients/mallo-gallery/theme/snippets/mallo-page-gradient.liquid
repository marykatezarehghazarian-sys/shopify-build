{%- comment -%}
  Mallo Gallery: site-wide animated wave background (Theme settings > Wave background).
  A fixed, full-screen layer at the very back (z-index -1). Page and section backgrounds are made
  transparent so the waves show through, while all content (text, images, buttons) sits on top
  untouched. Never blocks clicks.
{%- endcomment -%}
{%- if settings.page_gradient_enabled -%}
  <div
    class="mallo-page-gradient"
    aria-hidden="true"
    data-mallo-gradient
    data-color1="{{ settings.page_gradient_color1 }}"
    data-color2="{{ settings.page_gradient_color2 }}"
    data-color3="{{ settings.page_gradient_color3 }}"
    data-speed="{{ settings.page_gradient_speed }}"
    data-scale="0.45"
    data-rotation="-20"
    data-proportion="45"
    data-softness="100"
    data-distortion="4"
    data-swirl="55"
    data-swirl-iterations="6"
    data-shape="0"
    data-shape-size="30"
    data-offset="-235"
  ></div>
  <style>
    /* Waves live on the very back layer: behind every section, never over content. */
    html { background: {{ settings.page_gradient_color1 }}; }
    .mallo-page-gradient {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      opacity: {{ settings.page_gradient_strength | divided_by: 100.0 }};
    }
    /* Let the page-level backgrounds show the waves through; cards, drawers and pop-ups keep theirs. */
    body,
    #MainContent,
    main,
    .shopify-section,
    .shopify-section > .section,
    .section-background,
    .custom-section-background,
    .section-mallo-hero-fan .mhf {
      background: transparent !important;
    }
  </style>
  <script src="{{ 'mallo-animated-gradient.js' | asset_url }}" defer></script>
{%- endif -%}

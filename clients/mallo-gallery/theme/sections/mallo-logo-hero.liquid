{%- comment -%} Mallo Gallery: brand hero with the large logo, headline and buttons. {%- endcomment -%}
<div class="mallo-logo-hero" style="background: {{ section.settings.background }}; padding-block: {{ section.settings.padding }}px;">
  <div class="mallo-wrap mallo-logo-hero__inner">
    {%- assign logo = section.settings.logo | default: settings.logo -%}
    {%- if logo -%}
      {{ logo | image_url: width: 1400 | image_tag: class: 'mallo-logo-hero__logo', alt: shop.name, widths: '500,800,1100,1400', sizes: '(min-width: 750px) 640px, 85vw', loading: 'eager', fetchpriority: 'high' }}
    {%- endif -%}
    {%- if section.settings.heading != blank %}<h1 class="mallo-logo-hero__heading">{{ section.settings.heading | escape }}</h1>{% endif -%}
    {%- if section.settings.text != blank %}<p class="mallo-logo-hero__text">{{ section.settings.text | escape }}</p>{% endif -%}
    <div class="mallo-logo-hero__buttons">
      {%- if section.settings.button_label != blank -%}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
      {%- if section.settings.button2_label != blank -%}<a class="button button-secondary" href="{{ section.settings.button2_link | default: '#' }}">{{ section.settings.button2_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</div>
<style>
  .mallo-wrap { max-width: 1400px; margin-inline: auto; padding-inline: max(20px, 4vw); box-sizing: border-box; }
  .mallo-logo-hero__inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .mallo-logo-hero__logo { width: min(640px, 85vw); height: auto; }
  .mallo-logo-hero__heading { margin: 36px 0 8px; font-size: clamp(1.6rem, 3vw, 2.4rem); }
  .mallo-logo-hero__text { opacity: .8; margin: 0 0 28px; max-width: 560px; }
  .mallo-logo-hero__buttons { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
</style>
{% schema %}
{
  "name": "Mallo: logo hero",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (defaults to the theme logo)" },
    { "type": "color", "id": "background", "label": "Background", "default": "#000000" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Furniture made for the way you live" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Mallo: logo hero" }]
}
{% endschema %}

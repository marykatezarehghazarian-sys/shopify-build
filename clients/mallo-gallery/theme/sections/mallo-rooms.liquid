{%- comment -%} Mallo Gallery: "Shop by room" image tiles, one block per collection. {%- endcomment -%}
<div class="mallo-rooms mallo-wrap" style="padding-block: {{ section.settings.padding }}px;">
  {%- if section.settings.heading != blank -%}
    <div class="mallo-rooms__head">
      <h2 class="h3">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank %}<p>{{ section.settings.subheading | escape }}</p>{% endif -%}
    </div>
  {%- endif -%}
  <div class="mallo-rooms__grid">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      {%- assign img = block.settings.image | default: c.featured_image | default: c.products.first.featured_media -%}
      <a class="mallo-rooms__tile" href="{{ c.url | default: '#' }}" {{ block.shopify_attributes }}>
        <div class="mallo-rooms__media">
          {%- if img -%}
            {{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 990px) 25vw, 50vw', alt: c.title | escape }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'mallo-rooms__placeholder' }}
          {%- endif -%}
        </div>
        <span class="mallo-rooms__label">{{ block.settings.title | default: c.title | default: 'Collection' | escape }} <span aria-hidden="true">→</span></span>
      </a>
    {%- endfor -%}
  </div>
</div>
<style>
  .mallo-wrap { max-width: 1400px; margin-inline: auto; padding-inline: max(20px, 4vw); box-sizing: border-box; }
  .mallo-rooms__head { text-align: center; margin-bottom: 28px; }
  .mallo-rooms__head p { opacity: .75; margin-top: 6px; }
  .mallo-rooms__grid { display: grid; gap: 14px; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 750px) { .mallo-rooms__grid { grid-template-columns: repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }}, 1fr); } }
  .mallo-rooms__tile { display: block; text-decoration: none; color: inherit; }
  .mallo-rooms__media { aspect-ratio: 4 / 5; overflow: hidden; background: #F2EDE4; }
  .mallo-rooms__media img, .mallo-rooms__placeholder { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .mallo-rooms__placeholder { fill: rgb(0 0 0 / .2); }
  .mallo-rooms__tile:hover img { transform: scale(1.04); }
  .mallo-rooms__label { display: block; margin-top: 10px; font-weight: 500; letter-spacing: .02em; }
</style>
{% schema %}
{
  "name": "Mallo: shop by room",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by room" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "room", "name": "Room", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Label (optional)" },
      { "type": "image_picker", "id": "image", "label": "Image (optional, defaults to collection image)" }
    ] }
  ],
  "presets": [{ "name": "Mallo: shop by room" }]
}
{% endschema %}

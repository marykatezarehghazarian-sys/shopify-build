{%- comment -%} Mallo Gallery: contact actions (Google Maps directions + WhatsApp). {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id | prepend: 'mcb-'
  assign wa = s.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
-%}
<div id="{{ sid }}" class="mcb" style="padding-block: {{ s.padding }}px;">
  <div class="mcb__inner">
    {%- if s.heading != blank %}<h2 class="mcb__heading">{{ s.heading | escape }}</h2>{% endif -%}
    {%- if s.text != blank %}<p class="mcb__text">{{ s.text | escape }}</p>{% endif -%}
    <div class="mcb__buttons">
      {%- if s.maps_url != blank -%}
        <a class="mcb__btn mcb__btn--maps" href="{{ s.maps_url }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          <span>{{ s.maps_label | escape }}</span>
        </a>
      {%- endif -%}
      {%- if wa != blank -%}
        <a class="mcb__btn mcb__btn--wa" href="https://wa.me/{{ wa }}?text={{ s.whatsapp_message | url_encode }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16.04 3C9.4 3 4 8.36 4 14.97c0 2.11.56 4.17 1.62 5.99L4 29l8.24-1.6a12.1 12.1 0 0 0 3.8.61C22.68 28.01 28 22.65 28 16.04 28 9.43 22.68 3 16.04 3Zm0 22.8c-1.2 0-2.38-.2-3.5-.6l-.25-.09-4.9.95.98-4.77-.16-.26a9.73 9.73 0 0 1-1.5-5.07c0-5.4 4.4-9.78 9.83-9.78 5.42 0 9.6 4.38 9.6 9.86 0 5.47-4.44 9.76-10.1 9.76Zm5.4-7.3c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.57-.48-.5-.67-.5h-.57c-.2 0-.52.08-.79.37-.27.3-1.03 1-1.03 2.45s1.06 2.84 1.2 3.04c.15.2 2.08 3.17 5.04 4.45.7.3 1.25.48 1.68.62.7.22 1.35.19 1.85.12.57-.09 1.75-.72 2-1.4.24-.7.24-1.28.17-1.4-.07-.13-.27-.2-.57-.35Z"/></svg>
          <span>{{ s.whatsapp_label | escape }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
<style>
  #{{ sid }} .mcb__inner { max-width: 760px; margin: 0 auto; padding-inline: 20px; text-align: center; }
  #{{ sid }} .mcb__heading { margin: 0 0 8px; font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 400; }
  #{{ sid }} .mcb__text { margin: 0 0 22px; opacity: .75; }
  #{{ sid }} .mcb__buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  #{{ sid }} .mcb__btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 50px; padding: 0 26px; border-radius: 8px; font-weight: 500; text-decoration: none; transition: transform .15s, opacity .2s; }
  #{{ sid }} .mcb__btn:hover { transform: translateY(-1px); opacity: .92; }
  #{{ sid }} .mcb__btn svg { width: 22px; height: 22px; flex: none; }
  #{{ sid }} .mcb__btn--maps { background: #1A1714; color: #FFF; }
  #{{ sid }} .mcb__btn--wa { background: #25D366; color: #FFF; }
  @media (max-width: 749px) { #{{ sid }} .mcb__btn { flex: 1 1 100%; } }
</style>
{% schema %}
{
  "name": "Mallo: contact buttons",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visit or message us" },
    { "type": "text", "id": "text", "label": "Text", "default": "Our showroom is in Zahle. Get directions or chat with us on WhatsApp." },
    { "type": "text", "id": "maps_label", "label": "Maps button label", "default": "Get directions" },
    { "type": "url", "id": "maps_url", "label": "Google Maps link" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp button label", "default": "Chat on WhatsApp" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number", "default": "+9613195171" },
    { "type": "text", "id": "whatsapp_message", "label": "WhatsApp pre-filled message", "default": "Hello Mallo Gallery, I have a question." },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 }
  ],
  "presets": [{ "name": "Mallo: contact buttons" }]
}
{% endschema %}

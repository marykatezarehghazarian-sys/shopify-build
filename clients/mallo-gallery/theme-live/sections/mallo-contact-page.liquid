{%- comment -%}
  Mallo Gallery contact page (layout after theconceptmart.com/contact):
  banner with title + breadcrumb → white card of info items (location, phone, hours, email) →
  dark "Send us a message" band with the contact form → "Visit our showroom" band with directions.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- capture icon_location -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12Z"/><circle cx="12" cy="9" r="2.6"/></svg>{%- endcapture -%}
{%- capture icon_phone -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 9.5C4 7 7.6 5 12 5s8 2 8 4.5l-.3 1.2a1 1 0 0 1-1.2.7l-2.8-.7a1 1 0 0 1-.7-.8L14.7 8a10 10 0 0 0-5.4 0L9 9.9a1 1 0 0 1-.7.8l-2.8.7a1 1 0 0 1-1.2-.7L4 9.5Z"/><path d="M7.5 12.5 6 18h12l-1.5-5.5"/><circle cx="12" cy="15" r="1.6"/></svg>{%- endcapture -%}
{%- capture icon_clock -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="13" r="7.5"/><path d="M9 12.5 12 14.5 15.5 11.5M5 4 2.5 6.5M19 4l2.5 2.5M7 20l-1.5 1.5M17 20l1.5 1.5"/></svg>{%- endcapture -%}
{%- capture icon_email -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg>{%- endcapture -%}
{%- capture icon_whatsapp -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 20l1.2-4A8 8 0 1 1 8 18.8L4 20Z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.4-2-1-1 .8a4 4 0 0 1-1.9-1.9l.8-1-1-2L9 9.5Z"/></svg>{%- endcapture -%}

<section class="mcp" id="mcp-{{ section.id }}">
  <div class="mcp__banner"{% if s.banner_image != blank %} style="--mcp-bg: url('{{ s.banner_image | image_url: width: 2000 }}');"{% endif %}>
    <h1 class="mcp__title">{{ s.title | default: page.title | escape }}</h1>
    <nav class="mcp__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" aria-label="Home"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3.5 11 12 4l8.5 7M6 9.5V20h4.5v-5h3v5H18V9.5"/></svg></a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ s.title | default: page.title | escape }}</span>
    </nav>
  </div>

  <div class="mcp__card">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <div class="mcp__item" {{ block.shopify_attributes }}>
        <span class="mcp__icon">
          {%- case b.icon -%}
            {%- when 'phone' -%}{{ icon_phone }}
            {%- when 'clock' -%}{{ icon_clock }}
            {%- when 'email' -%}{{ icon_email }}
            {%- when 'whatsapp' -%}{{ icon_whatsapp }}
            {%- else -%}{{ icon_location }}
          {%- endcase -%}
        </span>
        <h2 class="mcp__item-title">{{ b.heading | escape }}</h2>
        <div class="mcp__item-text">
          {%- if b.link != blank -%}<a href="{{ b.link }}"{% if b.link contains 'http' %} target="_blank" rel="noopener"{% endif %}>{{ b.text }}</a>{%- else -%}{{ b.text }}{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  <div class="mcp__mail">
    <h2 class="mcp__band-title">{{ s.form_heading | escape }}</h2>
    {%- if s.form_text != blank %}<div class="mcp__band-text">{{ s.form_text }}</div>{% endif -%}
    {%- form 'contact', id: 'mcp-form', class: 'mcp__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="mcp__ok" role="status">{{ s.form_success | escape }}</p>
      {%- else -%}
        {%- if form.errors -%}<p class="mcp__err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="mcp__row">
          <label><span>Name</span><input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></label>
          <label><span>Phone</span><input type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></label>
        </div>
        <label><span>Email *</span><input type="email" name="contact[email]" required autocomplete="email" value="{{ form.email }}"></label>
        <label><span>Message</span><textarea name="contact[body]" rows="5">{{ form.body }}</textarea></label>
        <button type="submit" class="mcp__btn">{{ s.form_button | escape }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>

  <div class="mcp__visit">
    <h2 class="mcp__band-title mcp__band-title--accent">{{ s.visit_heading | escape }}</h2>
    {%- if s.visit_text != blank %}<div class="mcp__visit-text">{{ s.visit_text }}</div>{% endif -%}
    {%- if s.maps_url != blank -%}
      <a class="mcp__btn mcp__btn--outline" href="{{ s.maps_url }}" target="_blank" rel="noopener">{{ icon_location }}<span>Get directions</span></a>
    {%- endif -%}
    {%- if s.email != blank %}<p class="mcp__visit-line"><a href="mailto:{{ s.email }}">{{ s.email }}</a></p>{% endif -%}
    {%- if s.phone != blank -%}
      {%- assign tel = s.phone | remove: ' ' | remove: '-' -%}
      <p class="mcp__visit-phone"><a href="tel:{{ tel }}">{{ icon_phone }}<span>{{ s.phone }}</span></a></p>
    {%- endif -%}
  </div>
</section>

<style>
  #mcp-{{ section.id }} { --mcp-accent: {{ s.accent }}; --mcp-dark: {{ s.dark }}; color: var(--color-foreground, #1A1714); }
  #mcp-{{ section.id }} .mcp__banner { position: relative; display: grid; place-items: center; align-content: center; gap: 14px; min-height: clamp(220px, 32vw, 340px); padding: 40px 20px 80px; text-align: center; color: #fff;
    background: linear-gradient(rgb(26 23 20 / .55), rgb(26 23 20 / .55)), var(--mcp-bg, linear-gradient(135deg, #8a7f73, #3b342d)) center / cover no-repeat; }
  #mcp-{{ section.id }} .mcp__title { margin: 0; color: #fff; font-size: clamp(2rem, 5vw, 3.2rem); letter-spacing: .06em; text-transform: uppercase; }
  #mcp-{{ section.id }} .mcp__crumbs { display: flex; align-items: center; gap: 12px; font-size: 1.05rem; }
  #mcp-{{ section.id }} .mcp__crumbs a { color: #fff; display: inline-flex; }
  #mcp-{{ section.id }} .mcp__crumbs svg { width: 22px; height: 22px; }
  #mcp-{{ section.id }} .mcp__crumbs [aria-current] { color: var(--mcp-accent); }
  #mcp-{{ section.id }} .mcp__card { width: min(1100px, calc(100% - 32px)); margin: -56px auto 0; position: relative; z-index: 1; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px 24px; padding: clamp(36px, 5vw, 60px) 24px; background: #fff; box-shadow: 0 12px 40px rgb(26 23 20 / .08); text-align: center; }
  #mcp-{{ section.id }} .mcp__icon { display: inline-flex; color: var(--mcp-accent); }
  #mcp-{{ section.id }} .mcp__icon svg { width: 64px; height: 64px; }
  #mcp-{{ section.id }} .mcp__item-title { margin: 14px 0 10px; font-size: 1.25rem; font-weight: 500; color: inherit; }
  #mcp-{{ section.id }} .mcp__item-text { font-size: 1rem; line-height: 1.6; color: #5E5449; }
  #mcp-{{ section.id }} .mcp__item-text p { margin: 0 0 .9em; }
  #mcp-{{ section.id }} .mcp__item-text a { color: inherit; text-decoration: none; }
  #mcp-{{ section.id }} .mcp__item-text a:hover { color: var(--mcp-accent); }
  #mcp-{{ section.id }} .mcp__mail { margin-top: clamp(40px, 6vw, 72px); padding: clamp(48px, 7vw, 88px) 20px; background: var(--mcp-dark); color: #fff; text-align: center; }
  #mcp-{{ section.id }} .mcp__band-title { margin: 0 0 18px; color: inherit; font-size: clamp(1.6rem, 3.6vw, 2.4rem); letter-spacing: .06em; text-transform: uppercase; }
  #mcp-{{ section.id }} .mcp__band-title--accent { color: var(--mcp-accent); }
  #mcp-{{ section.id }} .mcp__band-text { max-width: 640px; margin: 0 auto 30px; font-size: 1.05rem; line-height: 1.7; opacity: .9; }
  #mcp-{{ section.id }} .mcp__form { display: grid; gap: 16px; width: min(640px, 100%); margin: 0 auto; text-align: left; }
  #mcp-{{ section.id }} .mcp__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  #mcp-{{ section.id }} .mcp__form label { display: grid; gap: 6px; font-size: .85rem; letter-spacing: .04em; }
  #mcp-{{ section.id }} .mcp__form :is(input, textarea) { width: 100%; padding: 12px 14px; border: 1px solid rgb(255 255 255 / .35); border-radius: 4px; background: rgb(255 255 255 / .06); color: #fff; font: inherit; resize: vertical; }
  #mcp-{{ section.id }} .mcp__form :is(input, textarea):focus-visible { outline: 2px solid var(--mcp-accent); outline-offset: 2px; }
  #mcp-{{ section.id }} .mcp__btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; justify-self: center; min-width: 240px; height: 52px; padding: 0 28px; border: 1px solid var(--mcp-accent); border-radius: 4px; background: var(--mcp-accent); color: #fff; font: inherit; font-size: 1.05rem; text-decoration: none; cursor: pointer; transition: background .2s, color .2s; }
  #mcp-{{ section.id }} .mcp__btn:hover { background: transparent; color: var(--mcp-accent); }
  #mcp-{{ section.id }} .mcp__btn svg { width: 22px; height: 22px; }
  #mcp-{{ section.id }} .mcp__btn--outline { background: transparent; border-color: #fff; color: #fff; margin: 8px 0 26px; }
  #mcp-{{ section.id }} .mcp__btn--outline:hover { border-color: var(--mcp-accent); }
  #mcp-{{ section.id }} :is(.mcp__ok, .mcp__err) { text-align: center; }
  #mcp-{{ section.id }} .mcp__visit { padding: clamp(48px, 7vw, 80px) 20px; background: #000; color: rgb(255 255 255 / .75); text-align: center; }
  #mcp-{{ section.id }} .mcp__visit-text { font-size: 1.05rem; line-height: 1.9; }
  #mcp-{{ section.id }} .mcp__visit-text p { margin: 0 0 6px; }
  #mcp-{{ section.id }} .mcp__visit-line a { color: inherit; text-decoration: none; font-size: 1.05rem; }
  #mcp-{{ section.id }} .mcp__visit-phone a { display: inline-flex; align-items: center; gap: 12px; margin-top: 14px; color: rgb(255 255 255 / .8); text-decoration: none; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 500; }
  #mcp-{{ section.id }} .mcp__visit-phone svg { width: 30px; height: 30px; }
  @media (max-width: 749px) { #mcp-{{ section.id }} .mcp__row { grid-template-columns: 1fr; } #mcp-{{ section.id }} .mcp__card { gap: 44px; } }
</style>

{% schema %}
{
  "name": "Mallo: contact page",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Contact" },
    { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
    { "type": "color", "id": "accent", "label": "Accent colour", "default": "#A8865B" },
    { "type": "color", "id": "dark", "label": "Message band colour", "default": "#2E2A26" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us a message" },
    { "type": "richtext", "id": "form_text", "label": "Form text" },
    { "type": "text", "id": "form_button", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "form_success", "label": "Thank-you message", "default": "Thank you, we'll get back to you very soon." },
    { "type": "text", "id": "visit_heading", "label": "Showroom heading", "default": "Visit our showroom" },
    { "type": "richtext", "id": "visit_text", "label": "Showroom text (address, hours)" },
    { "type": "url", "id": "maps_url", "label": "Google Maps link" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "text", "id": "phone", "label": "Phone" }
  ],
  "blocks": [
    { "type": "info", "name": "Info", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "location", "options": [ { "value": "location", "label": "Location" }, { "value": "phone", "label": "Phone" }, { "value": "clock", "label": "Hours" }, { "value": "email", "label": "Email" }, { "value": "whatsapp", "label": "WhatsApp" } ] },
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "Mallo: contact page" }]
}
{% endschema %}

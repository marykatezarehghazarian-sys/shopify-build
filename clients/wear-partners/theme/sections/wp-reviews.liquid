{%- comment -%}
  WearPartners: customer reviews. Each review is a block (name, stars, text, optional photo).
  Shows nothing to shoppers until at least one review is added in the theme editor
  (only real customer reviews should be added).
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- if section.blocks.size > 0 or request.design_mode -%}
<section id="wprv-{{ section.id }}" class="wprv" style="padding: {{ s.padding }}px max(16px, 4vw);">
  {%- if s.eyebrow != blank %}<p class="wprv__eyebrow">{{ s.eyebrow | escape }}</p>{% endif -%}
  {%- if s.heading != blank %}<h2 class="wprv__heading">{{ s.heading | escape }}</h2>{% endif -%}
  {%- if section.blocks.size == 0 -%}
    <p class="wprv__empty">Add reviews from your customers with “Add review”. This section is hidden on the store until it has at least one review.</p>
  {%- else -%}
    <div class="wprv__track">
      {%- for block in section.blocks -%}
        {%- assign stars = block.settings.rating | default: 5 -%}
        <figure class="wprv__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'wprv__img', alt: block.settings.name }}
          {%- endif -%}
          <div class="wprv__stars" role="img" aria-label="{{ stars }} out of 5 stars">
            {%- for i in (1..5) -%}<span class="{% if i <= stars %}on{% endif %}">★</span>{%- endfor -%}
          </div>
          <blockquote class="wprv__text">{{ block.settings.text }}</blockquote>
          <figcaption class="wprv__name">{{ block.settings.name | escape }}{% if block.settings.detail != blank %}<span>{{ block.settings.detail | escape }}</span>{% endif %}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
  #wprv-{{ section.id }} { text-align: center; }
  #wprv-{{ section.id }} .wprv__eyebrow { margin: 0 0 12px; font-size: .7rem; font-weight: 500; letter-spacing: .22em; text-transform: uppercase; color: #444; }
  #wprv-{{ section.id }} .wprv__heading { margin: 0 0 28px; font-family: var(--font-accent--family); font-weight: 500; font-size: clamp(1.4rem, 3vw, 2.1rem); color: #111; }
  #wprv-{{ section.id }} .wprv__empty { max-width: 520px; margin: 0 auto; padding: 24px; background: #fff; font-size: .9rem; color: #555; }
  #wprv-{{ section.id }} .wprv__track {
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(260px, 340px); gap: 14px;
    justify-content: safe center; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px;
    scrollbar-width: thin;
  }
  #wprv-{{ section.id }} .wprv__card {
    margin: 0; padding: 28px 24px 24px; background: rgb(255 255 255 / .9); scroll-snap-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center;
  }
  #wprv-{{ section.id }} .wprv__img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; margin-bottom: 4px; }
  #wprv-{{ section.id }} .wprv__stars { letter-spacing: 3px; font-size: .95rem; color: #cfcfcf; }
  #wprv-{{ section.id }} .wprv__stars .on { color: #111; }
  #wprv-{{ section.id }} .wprv__text { margin: 0; font-size: .92rem; line-height: 1.7; color: #333; }
  #wprv-{{ section.id }} .wprv__text p { margin: 0; }
  #wprv-{{ section.id }} .wprv__name { margin-top: auto; font-size: .72rem; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: #111; }
  #wprv-{{ section.id }} .wprv__name span { display: block; margin-top: 4px; font-weight: 400; letter-spacing: .08em; color: #777; text-transform: none; }
  @media (max-width: 749px) { #wprv-{{ section.id }} .wprv__track { grid-auto-columns: 82%; justify-content: start; } }
</style>
{%- endif -%}

{% schema %}
{
  "name": "WP: customer reviews",
  "class": "section-wp-reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "text", "id": "name", "label": "Customer name" },
      { "type": "text", "id": "detail", "label": "Detail", "info": "Optional, e.g. the item bought or the city." },
      { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "richtext", "id": "text", "label": "Review" },
      { "type": "image_picker", "id": "image", "label": "Photo", "info": "Optional, e.g. a customer photo or screenshot (with permission)." }
    ] }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "WP: customer reviews" }]
}
{% endschema %}

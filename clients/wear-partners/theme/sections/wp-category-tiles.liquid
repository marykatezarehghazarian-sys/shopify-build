{%- comment -%}
  WearPartners: category tiles in the style of luxury houses (Prada / Gucci):
  4 square tiles on light grey, product photo, small centred label underneath.
  Each block picks a collection; the image is the collection image, or its first product's image.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section id="wpct-{{ section.id }}" class="wpct" style="--wpct-cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }};">
  {%- if s.heading != blank -%}<h2 class="wpct__heading">{{ s.heading | escape }}</h2>{%- endif -%}
  <div class="wpct__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign c = block.settings.collection
        assign img = block.settings.image | default: c.products.first.featured_image | default: c.featured_image
        assign label = block.settings.label | default: c.title
      -%}
      <a class="wpct__tile" href="{{ c.url | default: '#' }}" {{ block.shopify_attributes }}>
        <span class="wpct__media">
          {%- if img != blank -%}
            {{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: label, class: 'wpct__img' }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'wpct__img wpct__ph' }}
          {%- endif -%}
        </span>
        <span class="wpct__label">
          <span class="wpct__name">{{ label | escape }}</span>
          <span class="wpct__cta">{{ section.settings.link_label | escape }}</span>
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>

<style>
  #wpct-{{ section.id }} { padding: {{ s.padding_top }}px max(16px, 3vw) {{ s.padding_bottom }}px; }
  #wpct-{{ section.id }} .wpct__heading {
    display: flex; align-items: center; gap: 18px; justify-content: center;
    margin: 0 auto 28px; max-width: 520px;
    font-family: var(--font-body--family); font-size: .75rem; font-weight: 500;
    letter-spacing: .22em; text-transform: uppercase; color: #111;
  }
  #wpct-{{ section.id }} .wpct__heading::before,
  #wpct-{{ section.id }} .wpct__heading::after { content: ''; flex: 1; height: 1px; background: currentColor; opacity: .35; }
  #wpct-{{ section.id }} .wpct__grid { display: grid; grid-template-columns: repeat(var(--wpct-cols), minmax(0, 1fr)); gap: 16px; max-width: 1600px; margin: 0 auto; }
  @media (max-width: 749px) {
    #wpct-{{ section.id }} .wpct__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    #wpct-{{ section.id }} .wpct__heading { margin-bottom: 20px; }
  }
  #wpct-{{ section.id }} .wpct__tile { display: flex; flex-direction: column; text-decoration: none; color: #111; background: #FFF; }
  #wpct-{{ section.id }} .wpct__media { display: block; aspect-ratio: 3 / 4; background: #EFEFEF; overflow: hidden; }
  #wpct-{{ section.id }} .wpct__img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; transition: transform 1s cubic-bezier(.22,1,.36,1); }
  #wpct-{{ section.id }} .wpct__ph { fill: rgb(0 0 0 / .15); }
  #wpct-{{ section.id }} .wpct__label { display: grid; justify-items: center; gap: 6px; padding: 16px 10px 18px; text-align: center; }
  #wpct-{{ section.id }} .wpct__name { font-family: var(--font-body--family); font-size: .78rem; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; line-height: 1.3; }
  #wpct-{{ section.id }} .wpct__cta { font-family: var(--font-body--family); font-size: .66rem; letter-spacing: .14em; text-transform: uppercase; color: #6b6b6b; padding-bottom: 2px; border-bottom: 1px solid transparent; transition: color .25s, border-color .25s; }
  @media (max-width: 749px) {
    #wpct-{{ section.id }} .wpct__label { padding: 12px 6px 14px; }
    #wpct-{{ section.id }} .wpct__name { font-size: .7rem; letter-spacing: .12em; }
  }
  @media (hover: hover) {
    #wpct-{{ section.id }} .wpct__tile:hover .wpct__img { transform: scale(1.04); }
    #wpct-{{ section.id }} .wpct__tile:hover .wpct__cta { color: #111; border-color: currentColor; }
  }
</style>

{% schema %}
{
  "name": "WP: category tiles",
  "class": "section-wp-category-tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "link_label", "label": "Link text under each name", "default": "Shop now" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    { "type": "tile", "name": "Category", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection name." },
      { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the first product photo in the collection." }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "WP: category tiles" }]
}
{% endschema %}

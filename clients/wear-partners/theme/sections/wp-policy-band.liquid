{%- comment -%}
  WearPartners: shipping and exchange policy, two neat columns on a white panel.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section id="wppb-{{ section.id }}" class="wppb" style="padding: {{ s.padding }}px max(16px, 4vw) 0;">
  <div class="wppb__panel">
    {%- if s.heading != blank %}<h2 class="wppb__heading">{{ s.heading | escape }}</h2>{% endif -%}
    <div class="wppb__cols">
      <div class="wppb__col">
        <svg class="wppb__icon" viewBox="0 0 32 32" aria-hidden="true"><path d="M3 9h16v13H3zM19 13h5l4 4v5h-9z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><circle cx="8.5" cy="23.5" r="2.3" fill="#fff" stroke="currentColor" stroke-width="1.3"/><circle cx="23.5" cy="23.5" r="2.3" fill="#fff" stroke="currentColor" stroke-width="1.3"/></svg>
        <h3 class="wppb__title">{{ s.shipping_title | escape }}</h3>
        <div class="wppb__text">{{ s.shipping_text }}</div>
      </div>
      <div class="wppb__col">
        <svg class="wppb__icon" viewBox="0 0 32 32" aria-hidden="true"><path d="M9 11h13a6 6 0 0 1 0 12H11" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M13 7 9 11l4 4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h3 class="wppb__title">{{ s.exchange_title | escape }}</h3>
        <div class="wppb__text">{{ s.exchange_text }}</div>
      </div>
    </div>
  </div>
</section>

<style>
  #wppb-{{ section.id }} .wppb__panel {
    max-width: 760px; margin: 0 auto; padding: clamp(32px, 5vw, 56px) clamp(22px, 5vw, 64px);
    background: rgb(255 255 255 / {{ s.panel_opacity | divided_by: 100.0 }});
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); color: #111; text-align: center;
  }
  #wppb-{{ section.id }} .wppb__heading { margin: 0 0 30px; font-size: .72rem; font-weight: 500; letter-spacing: .22em; text-transform: uppercase; color: #555; }
  #wppb-{{ section.id }} .wppb__cols { display: grid; grid-template-columns: 1fr 1fr; }
  #wppb-{{ section.id }} .wppb__col { padding: 0 clamp(14px, 3vw, 36px); }
  #wppb-{{ section.id }} .wppb__col + .wppb__col { border-left: 1px solid rgb(0 0 0 / .12); }
  #wppb-{{ section.id }} .wppb__icon { width: 30px; height: 30px; margin: 0 auto 14px; display: block; color: #111; }
  #wppb-{{ section.id }} .wppb__title { margin: 0 0 14px; font-size: .8rem; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: #111; }
  #wppb-{{ section.id }} .wppb__text { font-size: .9rem; line-height: 1.75; color: #333; }
  #wppb-{{ section.id }} .wppb__text p { margin: 0 0 8px; }
  #wppb-{{ section.id }} .wppb__text p:last-child { margin: 0; }
  @media (max-width: 749px) {
    #wppb-{{ section.id }} .wppb__cols { grid-template-columns: 1fr; gap: 26px; }
    #wppb-{{ section.id }} .wppb__col + .wppb__col { border-left: 0; border-top: 1px solid rgb(0 0 0 / .12); padding-top: 26px; }
  }
</style>

{% schema %}
{
  "name": "WP: shipping & exchanges",
  "class": "section-wp-policy-band",
  "settings": [
    { "type": "text", "id": "heading", "label": "Small label", "default": "Shipping & exchanges" },
    { "type": "text", "id": "shipping_title", "label": "Shipping title", "default": "Shipping" },
    { "type": "richtext", "id": "shipping_text", "label": "Shipping text", "default": "<p><strong>Beirut:</strong> daily delivery.</p><p><strong>Outside Beirut:</strong> 2–3 working days with Aramex.</p>" },
    { "type": "text", "id": "exchange_title", "label": "Exchange title", "default": "Exchanges" },
    { "type": "richtext", "id": "exchange_text", "label": "Exchange text", "default": "<p>Items cannot be tried on before purchase.</p><p>Exchanges within <strong>2 days</strong> of delivery, for the same item in a different size.</p><p>No returns or refunds.</p>" },
    { "type": "range", "id": "panel_opacity", "label": "Panel whiteness", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 80 },
    { "type": "range", "id": "padding", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "WP: shipping & exchanges" }]
}
{% endschema %}

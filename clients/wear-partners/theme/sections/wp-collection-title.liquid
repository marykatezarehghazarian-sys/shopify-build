{%- comment -%}
  WearPartners: collection page heading. Shows the collection's name, or the tag being
  browsed (e.g. /collections/all/hat shows "Hats"), and the collection description.
{%- endcomment -%}
{%- liquid
  assign wp_title = collection.title
  if current_tags.size > 0
    assign wp_tag = current_tags.first | downcase
    assign wp_title = current_tags | join: ' & '
    assign wp_pairs = section.settings.tag_titles | split: ','
    for pair in wp_pairs
      assign kv = pair | split: ':'
      assign k = kv.first | strip | downcase
      if k == wp_tag and kv.size > 1
        assign wp_title = kv.last | strip
      endif
    endfor
  endif
-%}
<div class="wpct-title" style="padding: {{ section.settings.padding_top }}px max(16px, 4vw) {{ section.settings.padding_bottom }}px;">
  <h1 class="wpct-title__h">{{ wp_title | escape }}</h1>
  {%- if current_tags.size == 0 and collection.description != blank -%}
    <div class="wpct-title__desc">{{ collection.description }}</div>
  {%- endif -%}
</div>

<style>
  .wpct-title { text-align: center; }
  .wpct-title__h {
    margin: 0; font-family: var(--font-body--family); font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: #111;
  }
  .wpct-title__desc { max-width: 560px; margin: 12px auto 0; font-size: .9rem; line-height: 1.7; color: #333; }
</style>

{% schema %}
{
  "name": "WP: collection title",
  "settings": [
    { "type": "text", "id": "tag_titles", "label": "Titles for tag pages", "info": "tag:Title pairs, separated by commas.", "default": "hat:Hats" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "WP: collection title" }]
}
{% endschema %}

{%- comment -%}
  WearPartners: brand story. A centred, quiet text panel over the video background:
  small label, serif headline, paragraphs, a sign-off line and an optional "DM us" link.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section id="wpbs-{{ section.id }}" class="wpbs">
  <div class="wpbs__panel">
    {%- if s.eyebrow != blank %}<p class="wpbs__eyebrow">{{ s.eyebrow | escape }}</p>{% endif -%}
    {%- if s.heading != blank %}<h2 class="wpbs__heading">{{ s.heading | escape }}</h2>{% endif -%}
    {%- if s.text != blank %}<div class="wpbs__text">{{ s.text }}</div>{% endif -%}
    {%- if s.signoff != blank %}<p class="wpbs__signoff">{{ s.signoff | escape }}</p>{% endif -%}
    {%- if s.cta_label != blank -%}
      {%- if s.cta_link != blank -%}
        <a class="wpbs__cta" href="{{ s.cta_link }}"{% if s.cta_link contains 'http' %} target="_blank" rel="noopener"{% endif %}>{{ s.cta_label | escape }}</a>
      {%- else -%}
        <p class="wpbs__cta wpbs__cta--text">{{ s.cta_label | escape }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<style>
  #wpbs-{{ section.id }} { padding: {{ s.padding }}px max(16px, 4vw); }
  #wpbs-{{ section.id }} .wpbs__panel {
    max-width: 760px; margin: 0 auto; padding: clamp(36px, 6vw, 72px) clamp(22px, 6vw, 80px);
    text-align: center; color: #111;
    background: rgb(255 255 255 / {{ s.panel_opacity | divided_by: 100.0 }});
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  #wpbs-{{ section.id }} .wpbs__eyebrow { margin: 0 0 18px; font-size: .7rem; font-weight: 500; letter-spacing: .22em; text-transform: uppercase; color: #555; }
  #wpbs-{{ section.id }} .wpbs__heading {
    margin: 0 0 26px; font-family: var(--font-accent--family); font-weight: 500;
    font-size: clamp(1.5rem, 3.4vw, 2.4rem); line-height: 1.2; letter-spacing: .01em; color: #111; text-wrap: balance;
  }
  #wpbs-{{ section.id }} .wpbs__text { font-size: .95rem; line-height: 1.8; color: #333; text-wrap: pretty; }
  #wpbs-{{ section.id }} .wpbs__text p { margin: 0 0 16px; }
  #wpbs-{{ section.id }} .wpbs__text p:last-child { margin-bottom: 0; }
  #wpbs-{{ section.id }} .wpbs__signoff {
    margin: 30px 0 0; padding-top: 26px; border-top: 1px solid rgb(0 0 0 / .12);
    font-size: .78rem; font-weight: 500; letter-spacing: .18em; text-transform: uppercase;
  }
  #wpbs-{{ section.id }} .wpbs__cta {
    display: inline-block; margin: 18px 0 0; padding-bottom: 3px; border-bottom: 1px solid currentColor;
    font-size: .72rem; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: #111; text-decoration: none;
  }
  #wpbs-{{ section.id }} .wpbs__cta--text { border-bottom-color: transparent; }
  @media (max-width: 749px) {
    #wpbs-{{ section.id }} .wpbs__text { font-size: .9rem; line-height: 1.75; }
  }
</style>

{% schema %}
{
  "name": "WP: brand story",
  "class": "section-wp-brand-story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "signoff", "label": "Sign-off line" },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "DM us to shop" },
    { "type": "url", "id": "cta_link", "label": "Link", "info": "For example your Instagram profile. Without a link, the label shows as plain text." },
    { "type": "range", "id": "panel_opacity", "label": "Panel whiteness", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 80 },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "WP: brand story" }]
}
{% endschema %}

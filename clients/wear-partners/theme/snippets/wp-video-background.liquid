{%- comment -%}
  WearPartners: full-page video background (black and white), fixed behind every section
  from header to footer. Settings: Theme settings → Video background.
  Uses a Files video if one is chosen, otherwise the bundled theme asset wp-bg-video.mp4.
  Reduced motion or data saver: shows the still poster instead of playing.
{%- endcomment -%}
{%- if settings.wp_vbg_enabled -%}
  {%- liquid
    assign vbg_src = 'wp-bg-video.mp4' | asset_url
    assign vbg_webm = 'wp-bg-video.webm' | asset_url
    assign vbg_poster = 'wp-bg-poster.jpg' | asset_url
    if settings.wp_vbg_video != blank
      assign vbg_src = settings.wp_vbg_video.sources | where: 'mime_type', 'video/mp4' | first | map: 'url' | first
      if vbg_src == blank
        assign vbg_src = settings.wp_vbg_video.sources.first.url
      endif
      assign vbg_poster = settings.wp_vbg_video.preview_image | image_url: width: 1280
      assign vbg_webm = blank
    endif
    assign vbg_veil = settings.wp_vbg_veil | divided_by: 100.0
  -%}
  <div class="wp-vbg" aria-hidden="true">
    <video class="wp-vbg__video" poster="{{ vbg_poster }}" muted loop playsinline preload="auto" disablepictureinpicture>
      <source src="{{ vbg_src }}" type="video/mp4">
      {%- if vbg_webm != blank %}<source src="{{ vbg_webm }}" type="video/webm">{% endif %}
    </video>
    <div class="wp-vbg__veil"></div>
  </div>
  <style>
    .wp-vbg { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; background: #8a8a8a; }
    .wp-vbg__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); }
    .wp-vbg__veil { position: absolute; inset: 0; background: {{ settings.wp_vbg_veil_color }}; opacity: {{ vbg_veil }}; }

    /* Let the video show through the page: body and full-width section backgrounds become transparent.
       Cards, drawers, popovers, inputs and the cart keep their own solid backgrounds. */
    html body { background-color: transparent; }
    main :is(.section-background, .section, .hero),
    .shopify-section-group-footer-group :is(.section-background, .section, footer) {
      background-color: transparent !important;
    }
    /* Header: frosted glass so the menu stays readable over the video. */
    #header-group .header__row,
    #header-group .announcement-bar {
      --header-bg-color: rgb(from var(--color-background) r g b / 0.72);
      background-color: rgb(from var(--color-background) r g b / 0.72);
      -webkit-backdrop-filter: blur(14px) saturate(1.1);
      backdrop-filter: blur(14px) saturate(1.1);
    }
  </style>
  <script>
    (() => {
      const v = document.querySelector('.wp-vbg__video');
      if (!v) return;
      const still = matchMedia('(prefers-reduced-motion: reduce)');
      const saver = navigator.connection && navigator.connection.saveData;
      v.muted = true;
      const sync = () => {
        if (still.matches || saver || document.hidden) v.pause();
        else v.play().catch(() => {});
      };
      document.addEventListener('visibilitychange', sync);
      still.addEventListener?.('change', sync);
      sync();
    })();
  </script>
{%- endif -%}

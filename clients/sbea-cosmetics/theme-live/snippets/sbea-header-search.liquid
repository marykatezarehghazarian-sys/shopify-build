<form class="sbea-header-search" action="{{ routes.search_url }}" method="get" role="search"><label for="SbeaHeaderSearch" class="visually-hidden">Search SBEA products</label><input id="SbeaHeaderSearch" name="q" type="search" placeholder="What are you looking for?" autocomplete="off"><input type="hidden" name="type" value="product"><button type="submit" aria-label="Search products"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button></form>
<style>.sbea-header-search{display:flex;align-items:center;width:clamp(280px,48vw,780px);background:#FFF0F5;border:1px solid #F3D6DF;border-radius:12px;margin-inline:24px}.sbea-header-search input[type=search]{min-width:0;flex:1;padding:14px 18px;border:0;background:none;color:#542634;font:inherit;font-size:14px;outline-offset:2px}.sbea-header-search button{display:grid;place-items:center;padding:13px;border:0;background:none;color:#C7356C;cursor:pointer}.sbea-header-search~search-button{display:none}.header__row--bottom .header__columns{padding-block:8px}.header__row--bottom a[href="/collections/bundles"]{color:#C7356C;font-weight:600}.header__row--top .header-logo svg{max-width:140px}@media(max-width:749px){.sbea-header-search{display:none}.sbea-header-search~search-button{display:block}}</style>
{% if template.name == 'index' or template.name == 'product' %}
<section class="sbea-feedback" aria-label="SBEA customer feedback">
<div class="sbea-feedback__heading"><span>THE SBEA RITUAL</span><h2>{{ section.settings.heading | escape }}</h2><p>Your SBEA experiences</p></div>
<div class="sbea-feedback__window"><div class="sbea-feedback__track">{% for copy in (1..2) %}<div class="sbea-feedback__set" {% if copy == 2 %}aria-hidden="true"{% endif %}><figure class="sbea-feedback__card"><span class="sbea-feedback__topic">{{ section.settings.topic_1 | escape }}</span><blockquote>{{ section.settings.quote_1 | escape }}</blockquote><figcaption><span class="sbea-feedback__avatar" aria-hidden="true">{{ section.settings.name_1 | slice: 0 | escape }}</span><span>{{ section.settings.name_1 | escape }}<small><span aria-hidden="true">✓</span> Verified customer</small></span></figcaption></figure><figure class="sbea-feedback__card"><span class="sbea-feedback__topic">{{ section.settings.topic_2 | escape }}</span><blockquote>{{ section.settings.quote_2 | escape }}</blockquote><figcaption><span class="sbea-feedback__avatar" aria-hidden="true">{{ section.settings.name_2 | slice: 0 | escape }}</span><span>{{ section.settings.name_2 | escape }}<small><span aria-hidden="true">✓</span> Verified customer</small></span></figcaption></figure><figure class="sbea-feedback__card"><span class="sbea-feedback__topic">{{ section.settings.topic_3 | escape }}</span><blockquote>{{ section.settings.quote_3 | escape }}</blockquote><figcaption><span class="sbea-feedback__avatar" aria-hidden="true">{{ section.settings.name_3 | slice: 0 | escape }}</span><span>{{ section.settings.name_3 | escape }}<small><span aria-hidden="true">✓</span> Verified customer</small></span></figcaption></figure><figure class="sbea-feedback__card"><span class="sbea-feedback__topic">{{ section.settings.topic_4 | escape }}</span><blockquote>{{ section.settings.quote_4 | escape }}</blockquote><figcaption><span class="sbea-feedback__avatar" aria-hidden="true">{{ section.settings.name_4 | slice: 0 | escape }}</span><span>{{ section.settings.name_4 | escape }}<small><span aria-hidden="true">✓</span> Verified customer</small></span></figcaption></figure><figure class="sbea-feedback__card"><span class="sbea-feedback__topic">{{ section.settings.topic_5 | escape }}</span><blockquote>{{ section.settings.quote_5 | escape }}</blockquote><figcaption><span class="sbea-feedback__avatar" aria-hidden="true">{{ section.settings.name_5 | slice: 0 | escape }}</span><span>{{ section.settings.name_5 | escape }}<small><span aria-hidden="true">✓</span> Verified customer</small></span></figcaption></figure><figure class="sbea-feedback__card"><span class="sbea-feedback__topic">{{ section.settings.topic_6 | escape }}</span><blockquote>{{ section.settings.quote_6 | escape }}</blockquote><figcaption><span class="sbea-feedback__avatar" aria-hidden="true">{{ section.settings.name_6 | slice: 0 | escape }}</span><span>{{ section.settings.name_6 | escape }}<small><span aria-hidden="true">✓</span> Verified customer</small></span></figcaption></figure><figure class="sbea-feedback__card"><span class="sbea-feedback__topic">{{ section.settings.topic_7 | escape }}</span><blockquote>{{ section.settings.quote_7 | escape }}</blockquote><figcaption><span class="sbea-feedback__avatar" aria-hidden="true">{{ section.settings.name_7 | slice: 0 | escape }}</span><span>{{ section.settings.name_7 | escape }}<small><span aria-hidden="true">✓</span> Verified customer</small></span></figcaption></figure><figure class="sbea-feedback__card"><span class="sbea-feedback__topic">{{ section.settings.topic_8 | escape }}</span><blockquote>{{ section.settings.quote_8 | escape }}</blockquote><figcaption><span class="sbea-feedback__avatar" aria-hidden="true">{{ section.settings.name_8 | slice: 0 | escape }}</span><span>{{ section.settings.name_8 | escape }}<small><span aria-hidden="true">✓</span> Verified customer</small></span></figcaption></figure></div>{% endfor %}</div></div>
</section>

{% endif %}
{% stylesheet %}
.sbea-feedback{padding:56px 0;background:#FFFFFF;color:#542634;overflow:hidden}
.sbea-feedback__heading{max-width:720px;margin:0 auto 28px;padding:0 24px;text-align:center}
.sbea-feedback__heading>span{font-size:.7rem;font-weight:700;letter-spacing:.16em;color:#BD3261}
.sbea-feedback__heading h2{margin:10px 0;font-size:clamp(1.9rem,3vw,2.7rem);letter-spacing:-.035em;line-height:1.15}
.sbea-feedback__heading p{font-size:.8rem;color:#805563;line-height:1.5;margin:0 0 12px}

.sbea-feedback__window{overflow:hidden}
.sbea-feedback__track{display:flex;width:max-content;animation:sbea-feedback-drift 100s linear infinite}
.sbea-feedback__set{display:flex;gap:20px;padding-right:20px}
.sbea-feedback__card{display:flex;flex-direction:column;width:320px;margin:0;padding:26px;border:1px solid #F3C5CF;border-radius:18px;background:#FFFFFF;box-sizing:border-box}
.sbea-feedback__topic{align-self:flex-start;padding:5px 10px;border-radius:999px;background:#FFE3D2;color:#A62453;font-size:.7rem;font-weight:700}
.sbea-feedback__card blockquote{margin:18px 0 24px;font-size:.95rem;line-height:1.7}
.sbea-feedback__card figcaption{display:flex;align-items:center;gap:12px;margin-top:auto;font-size:.85rem;font-weight:650}
.sbea-feedback__avatar{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:#FFD6E0;color:#A62453}
.sbea-feedback__card small{display:block;margin-top:3px;font-size:.7rem;color:#805563;font-weight:400}


@keyframes sbea-feedback-drift{to{transform:translateX(-50%)}}
@media(max-width:749px){.sbea-feedback{padding:40px 0}.sbea-feedback__card{width:280px;padding:22px}.sbea-feedback__set{gap:14px;padding-right:14px}}
@media(prefers-reduced-motion:reduce){.sbea-feedback__track{animation:none}.sbea-feedback__window{overflow-x:auto}.sbea-feedback__set[aria-hidden]{display:none}}

.sbea-feedback{padding:64px 0;background:#FFFFFF;border-top:1px solid #F5D6D8;border-bottom:1px solid #F5D6D8}
.sbea-feedback__heading{margin-bottom:32px}
.sbea-feedback__heading>span{letter-spacing:.19em;font-size:.68rem}
.sbea-feedback__heading h2{font-weight:500;font-size:clamp(2rem,3.4vw,3rem);margin:12px 0}
.sbea-feedback__heading p{font-size:.9rem;margin-bottom:16px}

.sbea-feedback__set{gap:22px;padding-right:22px}
.sbea-feedback__card{width:320px;min-height:240px;padding:28px;background:rgba(255,255,255,.94);border:1px solid #F5D6D8;border-radius:20px;box-shadow:0 5px 20px rgba(84,38,52,.04)}
.sbea-feedback__topic{background:#FFE8E1;font-size:.65rem;letter-spacing:.05em;padding:6px 11px}
.sbea-feedback__card blockquote{font-size:1.05rem;font-weight:400;line-height:1.65;margin:20px 0 26px}
.sbea-feedback__card figcaption{padding-top:18px;border-top:1px solid #F5D6D8}
.sbea-feedback__avatar{background:linear-gradient(135deg,#FFE3D2,#FFD6E0);width:38px;height:38px}
.sbea-feedback__card small{color:#A62453;font-size:.68rem;display:flex;align-items:center;gap:5px;margin-top:4px}
.sbea-feedback__card small>span{display:inline-grid;place-items:center;width:13px;height:13px;border-radius:50%;background:#BD3261;color:#fff;font-size:9px}
@media(max-width:749px){.sbea-feedback{padding:44px 0}.sbea-feedback__card{width:280px;min-height:230px;padding:24px}.sbea-feedback__set{gap:16px;padding-right:16px}}
{% endstylesheet %}

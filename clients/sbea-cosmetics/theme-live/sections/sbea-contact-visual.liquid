<section class="sbea-contact-visual section section--page-width">
  {% assign visual_product = section.settings.product %}
  <div class="sbea-contact-visual__shell">
    <div class="sbea-contact-visual__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 900 | image_tag: widths: '420, 620, 900', sizes: '(min-width: 750px) 42vw, 100vw', loading: 'lazy', class: 'sbea-contact-visual__image', alt: section.settings.image_alt }}
      {% elsif visual_product != blank and visual_product.featured_image != blank %}
        {{ visual_product.featured_image | image_url: width: 900 | image_tag: widths: '420, 620, 900', sizes: '(min-width: 750px) 42vw, 100vw', loading: 'lazy', class: 'sbea-contact-visual__image', alt: visual_product.featured_image.alt | default: section.settings.image_alt }}
      {% endif %}
    </div>
    <div class="sbea-contact-visual__copy">
      <p class="sbea-contact-visual__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
  </div>
</section>
{% stylesheet %}
.sbea-contact-visual{padding-block:18px 28px}.sbea-contact-visual__shell{display:grid;grid-template-columns:minmax(280px,.75fr) minmax(0,1fr);align-items:center;gap:40px;padding:28px;border-radius:22px;background:#FFFFFF}.sbea-contact-visual__media{aspect-ratio:4/5;overflow:hidden;border-radius:18px;background:#fff}.sbea-contact-visual__image{width:100%;height:100%;object-fit:contain;padding:5%;background:#fff}.sbea-contact-visual__eyebrow{margin:0 0 8px;color:#C7356C;font-size:.78rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.sbea-contact-visual__copy h2{margin:0 0 12px}.sbea-contact-visual__copy p{max-width:34rem;margin:0;line-height:1.7;opacity:.76}@media(max-width:749px){.sbea-contact-visual__shell{grid-template-columns:1fr;gap:22px;padding:20px}.sbea-contact-visual__copy{padding:0 4px 8px}}
{% endstylesheet %}
{% schema %}
{"name":"SBEA contact visual","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"We’re here for you"},{"type":"text","id":"heading","label":"Heading","default":"How can we help?"},{"type":"textarea","id":"text","label":"Text","default":"Contact us for help choosing products or checking your order"},{"type":"product","id":"product","label":"Fallback product image"},{"type":"image_picker","id":"image","label":"Custom image"},{"type":"text","id":"image_alt","label":"Image alt text","default":"SBEA beauty product on a soft pink background"}],"presets":[{"name":"SBEA contact visual"}]}
{% endschema %}
<section class="sbea-collection-hero section section--page-width">
  {% assign collection_media = collection.image %}
  {% if collection_media == blank and collection.products.first != blank %}
    {% assign collection_media = collection.products.first.featured_image %}
  {% endif %}
  <div class="sbea-collection-hero__shell">
    <div class="sbea-collection-hero__copy">
      <p class="sbea-collection-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ collection.title }}</h1>
      {% if collection.description != blank %}<div class="sbea-collection-hero__description">{{ collection.description }}</div>{% endif %}
    </div>
    <div class="sbea-collection-hero__media">
      {% if collection_media != blank %}
        {{ collection_media | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 750px) 42vw, 100vw', loading: 'eager', class: 'sbea-collection-hero__image', alt: collection.title | append: ' collection' }}
      {% else %}
        <div class="sbea-collection-hero__placeholder" aria-hidden="true"></div>
      {% endif %}
    </div>
  </div>
</section>
{% stylesheet %}
.sbea-collection-hero{padding-block:28px}.sbea-collection-hero__shell{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.72fr);align-items:center;overflow:hidden;border-radius:22px;background:#FFFFFF}.sbea-collection-hero__copy{padding:clamp(28px,4vw,52px)}.sbea-collection-hero__eyebrow{margin:0 0 8px;font-size:.78rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#C7356C}.sbea-collection-hero__copy h1{margin:0 0 10px}.sbea-collection-hero__description{max-width:42rem;line-height:1.7;opacity:.75}.sbea-collection-hero__media{height:100%;min-height:300px;background:#fff}.sbea-collection-hero__image{width:100%;height:100%;object-fit:contain;object-position:center;padding:5%;background:#fff}.sbea-collection-hero__placeholder{width:100%;height:100%;background:linear-gradient(145deg,#fff,#F3C5CF)}@media(max-width:749px){.sbea-collection-hero{padding-block:18px}.sbea-collection-hero__shell{grid-template-columns:1fr}.sbea-collection-hero__copy{padding:28px 22px}.sbea-collection-hero__media{min-height:0;aspect-ratio:16/10}}
{% endstylesheet %}
{% schema %}
{"name":"SBEA collection hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop SBEA"}],"presets":[{"name":"SBEA collection hero"}]}
{% endschema %}
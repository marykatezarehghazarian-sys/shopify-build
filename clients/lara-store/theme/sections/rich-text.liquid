<div class="section page-width" style="text-align: {{ section.settings.align }}">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}<h2 {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
      {%- when 'text' -%}<div {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {%- when 'button' -%}<a class="button" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
    {%- endcase -%}
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "Rich text",
  "settings": [{ "type": "select", "id": "align", "label": "Alignment", "default": "center",
    "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }] }],
  "blocks": [
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Welcome" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story.</p>" }] },
    { "type": "button", "name": "Button", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Shop now" },
      { "type": "url", "id": "link", "label": "Link" } ] }
  ],
  "presets": [{ "name": "Rich text", "blocks": [{ "type": "heading" }, { "type": "text" }] }]
}
{% endschema %}

{%- comment -%}
  Elle.ay personalization fields for the product page. Which fields a product shows is set on the
  product itself (metafields in the "elleay" namespace), so one product template serves every piece:
    elleay.fields      list of: name, photo, notes, ribbon
    elleay.only_when   option value that switches the fields on (e.g. "Personalized"); empty = always
    elleay.name_label  label for the text field (default "Name")
    elleay.name_max    character limit for the text field
    elleay.production  e.g. "Made to order in 3–5 days"
  Inputs join the add-to-cart form through the form attribute, so they travel with the order as
  line item properties and show on the order for the workshop.
{%- endcomment -%}
{%- assign product = closest.product -%}
{%- assign mf = product.metafields.elleay -%}
{%- assign fields = mf.fields.value -%}
{%- assign form_id = 'BuyButtons-ProductForm-' | append: section.id -%}
{%- assign uid = block.id | prepend: 'ea-p-' -%}
{%- assign only_when = mf.only_when.value | default: '' -%}
{%- assign name_label = mf.name_label.value | default: block.settings.name_label -%}
{%- assign name_max = mf.name_max.value | default: block.settings.name_max -%}

<div class="ea-p" id="{{ uid }}" data-only-when="{{ only_when | escape }}" {{ block.shopify_attributes }}>
  {%- if fields.size > 0 -%}
    <fieldset class="ea-p__box"{% if only_when != blank %} hidden{% endif %}>
      <legend class="ea-p__legend">{{ block.settings.heading | escape }}</legend>
      {%- if fields contains 'name' -%}
        <div class="ea-p__field">
          <label for="{{ uid }}-name">{{ name_label | escape }}</label>
          <input id="{{ uid }}-name" type="text" name="properties[{{ name_label | escape }}]" form="{{ form_id }}" maxlength="{{ name_max }}" autocomplete="off" data-ea-required {% if only_when == blank %}required{% endif %}>
          <p class="ea-p__help"><span data-ea-count>0</span>/{{ name_max }} · <span data-ea-preview-label>{{ block.settings.preview_label | escape }}</span> <em data-ea-preview></em></p>
        </div>
      {%- endif -%}
      {%- if fields contains 'photo' -%}
        <div class="ea-p__field">
          <label for="{{ uid }}-photo">{{ block.settings.photo_label | escape }}</label>
          <input id="{{ uid }}-photo" type="file" name="properties[Photo]" form="{{ form_id }}" accept="image/jpeg,image/png,image/heic,image/webp">
          <p class="ea-p__help">{{ block.settings.photo_help | escape }}</p>
        </div>
      {%- endif -%}
      {%- if fields contains 'ribbon' -%}
        <div class="ea-p__field">
          <span class="ea-p__label">{{ block.settings.ribbon_label | escape }}</span>
          <div class="ea-p__choices">
            <label><input type="radio" name="properties[Ribbon]" value="No ribbon" form="{{ form_id }}" checked> No</label>
            <label><input type="radio" name="properties[Ribbon]" value="Add a ribbon" form="{{ form_id }}"> Yes, add a ribbon</label>
          </div>
        </div>
      {%- endif -%}
      {%- if fields contains 'notes' -%}
        <div class="ea-p__field">
          <label for="{{ uid }}-notes">{{ block.settings.notes_label | escape }}</label>
          <textarea id="{{ uid }}-notes" name="properties[Notes]" form="{{ form_id }}" rows="3" maxlength="500" placeholder="{{ block.settings.notes_placeholder | escape }}"></textarea>
        </div>
      {%- endif -%}
      {%- if block.settings.approval_note != blank and fields contains 'photo' -%}
        <p class="ea-p__note">{{ block.settings.approval_note | escape }}</p>
      {%- endif -%}
    </fieldset>
  {%- endif -%}

  <ul class="ea-p__facts" role="list">
    {%- if mf.production.value != blank -%}<li>{{ mf.production.value | escape }}</li>{%- elsif block.settings.ready != blank -%}<li>{{ block.settings.ready | escape }}</li>{%- endif -%}
    {%- if block.settings.delivery != blank %}<li>{{ block.settings.delivery | escape }}</li>{% endif -%}
    {%- if fields.size > 0 -%}
      {%- comment -%} Personalized-only lines: hidden with the fields when the option doesn't match (e.g. Classic wallet). {%- endcomment -%}
      {%- if block.settings.prepay != blank %}<li class="ea-p__prepay" data-ea-personal{% if only_when != blank %} hidden{% endif %}><strong>{{ block.settings.prepay | escape }}</strong></li>{% endif -%}
      {%- if block.settings.returns != blank %}<li data-ea-personal{% if only_when != blank %} hidden{% endif %}>{{ block.settings.returns | escape }}</li>{% endif -%}
    {%- endif -%}
  </ul>

  {%- if fields.size > 0 and block.settings.whatsapp != blank -%}
    {%- assign wa = block.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
    {%- capture wa_text -%}{{ block.settings.whatsapp_message | replace: '[product]', product.title }} {{ shop.url }}{{ product.url }}{%- endcapture -%}
    <a class="ea-p__wa" href="https://wa.me/{{ wa }}?text={{ wa_text | strip | url_encode }}" target="_blank" rel="noopener">
      <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2Zm0 18.15a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 4.54 0 8.24 3.7 8.24 8.24 0 4.54-3.7 8.24-8.24 8.24Zm4.52-6.16c-.25-.12-1.46-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.29Z"/></svg>
      <span>{{ block.settings.whatsapp_label | escape }}</span>
    </a>
    {%- if block.settings.whatsapp_note != blank %}<p class="ea-p__help ea-p__wa-note">{{ block.settings.whatsapp_note | escape }}</p>{% endif -%}
  {%- endif -%}
</div>

<script src="{{ 'ea-personalise.js' | asset_url }}" defer></script>

<style>
  #{{ uid }} { width: 100%; }
  #{{ uid }} .ea-p__box { border: 1px solid var(--ea-line, #e7ded4); background: #fff; padding: 20px; margin: 0 0 16px; display: grid; gap: 18px; min-width: 0; }
  #{{ uid }} .ea-p__box[hidden] { display: none; }
  #{{ uid }} .ea-p__legend { padding: 0 6px; font: 400 11px/1.4 var(--ea-sans); letter-spacing: .18em; text-transform: uppercase; }
  #{{ uid }} .ea-p__field { display: grid; gap: 8px; }
  #{{ uid }} label, #{{ uid }} .ea-p__label { font: 400 13px/1.4 var(--ea-sans); }
  #{{ uid }} input[type="text"], #{{ uid }} textarea { width: 100%; min-height: 46px; border: 1px solid var(--ea-line, #e7ded4); background: var(--ea-bg, #faf7f3); padding: 10px 12px; font: 300 15px/1.4 var(--ea-sans); color: inherit; border-radius: 0; }
  #{{ uid }} input[type="file"] { font: 300 14px var(--ea-sans); min-height: 44px; }
  #{{ uid }} .ea-p__choices { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  #{{ uid }} .ea-p__choices label { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; }
  #{{ uid }} .ea-p__help, #{{ uid }} .ea-p__note { margin: 0; font: 300 13px/1.5 var(--ea-sans); color: var(--ea-muted, #6b5f58); }
  #{{ uid }} .ea-p__help em { font: italic 400 16px var(--ea-serif); color: var(--ea-ink, #2a2522); }
  #{{ uid }} .ea-p__facts { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 6px; font: 300 13.5px/1.5 var(--ea-sans); color: var(--ea-muted, #6b5f58); }
  #{{ uid }} .ea-p__facts li[hidden] { display: none; }
  #{{ uid }} .ea-p__prepay { color: var(--ea-ink, #2a2522); }
  #{{ uid }} .ea-p__prepay strong { font-weight: 500; }
  #{{ uid }} .ea-p__wa { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 48px; margin-top: 16px; padding: 12px 20px; border: 1px solid var(--ea-ink, #2a2522); background: transparent; color: var(--ea-ink, #2a2522); text-decoration: none; font: 400 12px/1.3 var(--ea-sans); letter-spacing: .14em; text-transform: uppercase; transition: background-color .2s, color .2s; }
  #{{ uid }} .ea-p__wa:hover { background: var(--ea-ink, #2a2522); color: #fff; }
  #{{ uid }} .ea-p__wa:focus-visible { outline: 2px solid var(--ea-ink, #2a2522); outline-offset: 3px; }
  #{{ uid }} .ea-p__wa-note { margin-top: 8px; text-align: center; }
  #{{ uid }} .ea-p__facts li::before { content: '—'; margin-inline-end: 8px; }
</style>

{% schema %}
{
  "name": "Elle.ay: personalization",
  "settings": [
    { "type": "paragraph", "content": "Which fields show is set on each product (metafields elleay.fields, elleay.only_when, elleay.name_label, elleay.name_max, elleay.production)." },
    { "type": "text", "id": "heading", "label": "Box title", "default": "Make it yours" },
    { "type": "text", "id": "name_label", "label": "Default text field label", "default": "Name" },
    { "type": "number", "id": "name_max", "label": "Default character limit", "default": 20 },
    { "type": "text", "id": "preview_label", "label": "Preview label", "default": "Preview:" },
    { "type": "text", "id": "photo_label", "label": "Photo field label", "default": "Upload a photo (optional)" },
    { "type": "text", "id": "photo_help", "label": "Photo help text", "default": "JPG or PNG. You can also send it to us on WhatsApp after ordering." },
    { "type": "text", "id": "ribbon_label", "label": "Ribbon question", "default": "Ribbon" },
    { "type": "text", "id": "notes_label", "label": "Notes label", "default": "Your idea or notes (optional)" },
    { "type": "text", "id": "notes_placeholder", "label": "Notes placeholder", "default": "Colors, a date, a short message…" },
    { "type": "text", "id": "approval_note", "label": "Approval note", "default": "We'll send you a virtual design on WhatsApp to approve before we make it." },
    { "type": "text", "id": "ready", "label": "Preparation time line (used when the product has no elleay.production)", "default": "Some orders need up to 72 hours to be ready" },
    { "type": "text", "id": "delivery", "label": "Delivery line", "default": "Delivery across Lebanon and worldwide" },
    { "type": "text", "id": "prepay", "label": "Payment line (personalized items)", "default": "Personalized pieces are paid in advance by Whish or card, before we start making them" },
    { "type": "text", "id": "returns", "label": "Returns line (personalized items)", "default": "Personalized pieces are made just for you and can't be returned" },
    { "type": "header", "content": "WhatsApp button (personalized items)" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "info": "International format, e.g. +961 70 000 000. The button hides when this is empty." },
    { "type": "text", "id": "whatsapp_label", "label": "Button label", "default": "Personalize on WhatsApp" },
    { "type": "text", "id": "whatsapp_message", "label": "Prefilled message", "info": "[product] becomes the product name; the product link is added at the end.", "default": "Hi Elle.ay! I'd like to personalize the [product]." },
    { "type": "text", "id": "whatsapp_note", "label": "Note under the button", "default": "Send us your name, photo or idea and we'll design it with you." }
  ],
  "presets": [{ "name": "Elle.ay: personalization" }]
}
{% endschema %}

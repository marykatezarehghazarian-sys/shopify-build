<a class="card reveal" href="{{ product.url }}">
  <div class="card__media" style="position:relative">
    {% render 'pkg-art', product: product %}
    {%- if product.tags contains 'popular' -%}<span class="badge">Popular</span>{%- endif -%}
  </div>
  <div class="card__body">
    {%- if product.collections.first -%}<span class="card__cat">{{ product.collections.first.title }}</span>{%- endif -%}
    <span class="card__title">{{ product.title }}</span>
    <span class="card__cta">Get a quote →</span>
  </div>
</a>

[
  {
    "name": "theme_info",
    "theme_name": "PKG Packaging",
    "theme_version": "1.0.0",
    "theme_author": "shopify-build",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://shopify.dev"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "business_name",
        "label": "Business name (Google & social)",
        "default": "PKG. Packaging Factory"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Leave empty to show the text logo \"PKG.\""
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo height",
        "min": 24,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon (square, 96px+)",
        "info": "Shown in the browser tab and Google results."
      },
      {
        "type": "text",
        "id": "logo_text",
        "label": "Text logo",
        "default": "PKG"
      },
      {
        "type": "text",
        "id": "logo_sub",
        "label": "Text logo subtitle",
        "default": "Packaging Factory"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink (text, dark sections)",
        "default": "#121212"
      },
      {
        "type": "color",
        "id": "color_paper",
        "label": "Background",
        "default": "#F3EEE6"
      },
      {
        "type": "color",
        "id": "color_kraft",
        "label": "Kraft",
        "default": "#C9A27A"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#21642F"
      }
    ]
  },
  {
    "name": "Contact & WhatsApp",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp",
        "label": "WhatsApp number",
        "info": "International format, e.g. +961 3 400 054",
        "default": "+961 3 400 054"
      },
      {
        "type": "text",
        "id": "wa_message",
        "label": "Default WhatsApp message",
        "default": "Hi PKG, I would like a quote."
      },
      {
        "type": "text",
        "id": "email",
        "label": "Email",
        "default": "rafi@printw-ps.com"
      },
      {
        "type": "text",
        "id": "instagram",
        "label": "Instagram handle (without @)",
        "default": "pkg.packagingfactory"
      },
      {
        "type": "url",
        "id": "facebook_url",
        "label": "Facebook page link"
      },
      {
        "type": "checkbox",
        "id": "wa_float",
        "label": "Show floating WhatsApp button",
        "default": true
      }
    ]
  },
  {
    "name": "Showroom",
    "settings": [
      {
        "type": "text",
        "id": "showroom_address",
        "label": "Address"
      },
      {
        "type": "text",
        "id": "business_city",
        "label": "City / area",
        "info": "e.g. Dekwaneh. Used by Google."
      },
      {
        "type": "textarea",
        "id": "showroom_hours",
        "label": "Opening hours"
      },
      {
        "type": "url",
        "id": "showroom_map_link",
        "label": "Google Maps link (Directions button)"
      },
      {
        "type": "text",
        "id": "showroom_map_query",
        "label": "Map search text",
        "info": "Shown as an embedded map, e.g. \"PKG Packaging Factory, Beirut\""
      },
      {
        "type": "text",
        "id": "opening_hours_schema",
        "label": "Opening hours for Google",
        "info": "Format: Mo-Fr 08:00-17:00, Sa 08:00-13:00"
      },
      {
        "type": "text",
        "id": "geo_lat",
        "label": "Map latitude",
        "info": "From Google Maps (right-click the pin)."
      },
      {
        "type": "text",
        "id": "geo_lng",
        "label": "Map longitude"
      }
    ]
  },
  {
    "name": "Payment & delivery",
    "settings": [
      {
        "type": "text",
        "id": "payment_line",
        "label": "Payment line",
        "default": "Cash on delivery · Whish · OMT"
      },
      {
        "type": "text",
        "id": "delivery_line",
        "label": "Delivery line",
        "default": "All over Lebanon and the Middle East"
      }
    ]
  },
  {
    "name": "SEO & Google",
    "settings": [
      {
        "type": "text",
        "id": "seo_home_title",
        "label": "Homepage title in Google",
        "info": "Up to ~60 characters.",
        "default": "PKG. Packaging Factory | Custom Printing & Packaging in Lebanon"
      },
      {
        "type": "textarea",
        "id": "seo_home_description",
        "label": "Homepage description in Google",
        "info": "Up to ~155 characters.",
        "default": "Custom printed boxes, paper bags, cups, labels and business print for restaurants, bakeries, cafés and brands. Made in Lebanon. Quote on WhatsApp."
      },
      {
        "type": "textarea",
        "id": "seo_default_description",
        "label": "Fallback description",
        "default": "PKG. Packaging Factory prints custom packaging and business print in Lebanon: boxes, paper bags, cups, labels, menus and stationery. Delivery across Lebanon and the Middle East."
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Share image (WhatsApp, Facebook)",
        "info": "1200×630 recommended. Falls back to the logo."
      },
      {
        "type": "text",
        "id": "google_site_verification",
        "label": "Google Search Console verification code",
        "info": "Only the content=\"...\" value."
      }
    ]
  }
]
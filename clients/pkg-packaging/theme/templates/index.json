    "faq": {
      "type": "pkg-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "Can you print my logo on any product?",
            "answer": "Yes. Every product in the catalogue is made to order with your logo and colours, from one colour up to full colour."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "What is the minimum order?",
            "answer": "It depends on the product and the printing. Tell us what you need on WhatsApp and we'll confirm the minimum with your quote."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "How do I pay?",
            "answer": "Cash on delivery, Whish or OMT. We'll confirm the total with you before production."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "Where do you deliver?",
            "answer": "All over Lebanon and across the Middle East. Delivery time depends on the product and the quantity."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "Can I see samples first?",
            "answer": "Yes. Visit our showroom to see and feel the materials, or ask us on WhatsApp for photos of similar work."
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",

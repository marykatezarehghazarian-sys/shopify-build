    "steps": {
      "type": "pkg-steps",
      "blocks": {
        "s1": {
          "type": "step",
          "settings": {
            "title": "Tell us what you need",
            "text": "Pick a product and send us the quantity, size and your logo on WhatsApp."
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "title": "Get your quote",
            "text": "We confirm the price, material and timing, and send a design proof."
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "title": "We print it",
            "text": "Your order is produced in our factory once you approve the proof."
          }
        },
        "s4": {
          "type": "step",
          "settings": {
            "title": "Delivered to you",
            "text": "We deliver all over Lebanon and the Middle East. Pay cash, Whish or OMT."

<section class="section"><div class="wrap split">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead" style="margin-top:18px">{{ section.settings.text }}</p>{%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_1 != blank -%}<a class="btn" href="{{ section.settings.link_1 }}">{{ section.settings.button_1 }}</a>{%- endif -%}
        {%- if section.settings.button_2 != blank -%}<a class="btn btn--ghost" href="{{ section.settings.link_2 }}">{{ section.settings.button_2 }}</a>{%- endif -%}
      </div>
    </div>
    <div class="panel"><dl class="specs" style="margin:0">
      {%- for block in section.blocks -%}<div {{ block.shopify_attributes }}><dt>{{ block.settings.title }}</dt><dd>{{ block.settings.text }}</dd></div>{%- endfor -%}
    </dl></div>
</div></section>
{% schema %}
{
  "name": "PKG why us",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Why PKG." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One factory for all your printing & packaging" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Boxes, cups, bags, labels and business print from one supplier, so your brand looks the same on every piece." },
    { "type": "text", "id": "button_1", "label": "Button 1", "default": "About us" }, { "type": "url", "id": "link_1", "label": "Button 1 link" },
    { "type": "text", "id": "button_2", "label": "Button 2", "default": "Visit the showroom" }, { "type": "url", "id": "link_2", "label": "Button 2 link" }
  ],
  "blocks": [ { "type": "point", "name": "Point", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Point" }, { "type": "text", "id": "text", "label": "Text" } ] } ],
  "presets": [{ "name": "PKG why us" }]
}
{% endschema %}

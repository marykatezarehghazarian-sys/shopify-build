{%- if section.settings.announcement != blank -%}
  <div class="announce">{{ section.settings.announcement }}</div>
{%- endif -%}
<header class="header">
  <div class="wrap header__row">
    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: height: 160 | image_tag: alt: shop.name }}
      {%- else -%}
        {{ settings.logo_text }}<span class="logo__dot">.</span><span class="logo__sub">{{ settings.logo_sub | replace: ' ', '<br>' }}</span>
      {%- endif -%}
    </a>
    <nav class="nav" id="nav" aria-label="Main">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.active or link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    {%- if settings.whatsapp != blank -%}
      <a class="btn btn--wa header__cta" href="{% render 'wa-url' %}" target="_blank" rel="noopener">{% render 'pkg-icon', name: 'whatsapp' %}{{ section.settings.cta }}</a>
    {%- endif -%}
    <button class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="nav">{% render 'pkg-icon', name: 'menu' %}</button>
  </div>
</header>
{%- if settings.logo -%}<style>.logo img{height:{{ settings.logo_height }}px;width:auto}</style>{%- endif -%}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "inline_richtext", "id": "announcement", "label": "Announcement bar", "default": "Custom printing & packaging · <strong>Delivery all over Lebanon & the Middle East</strong> · Cash on delivery, Whish or OMT" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "cta", "label": "Button label", "default": "WhatsApp us" }
  ]
}
{% endschema %}

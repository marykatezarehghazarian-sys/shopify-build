<section class="section"><div class="wrap">
    <div class="section__head">
      <div>{%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2 class="h2">{{ section.settings.heading }}</h2></div>
      {%- if section.settings.text != blank -%}<p class="lead" style="max-width:44ch">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="cats">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="cat reveal" href="{{ c.url | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          <span class="cat__arrow" aria-hidden="true">→</span>
          <span class="cat__icon">{% render 'pkg-icon-for', handle: c.handle %}</span>
          <span><span class="cat__name">{{ block.settings.title | default: c.title }}</span><span class="cat__count" style="display:block">{{ c.products_count }} products</span></span>
        </a>
      {%- endfor -%}
    </div>
</div></section>
{% schema %}
{
  "name": "PKG categories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "What we make" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every product is printed with your logo, colours and sizes. Choose a category, then ask for a quote in one tap." }
  ],
  "blocks": [ { "type": "category", "name": "Category", "settings": [ { "type": "collection", "id": "collection", "label": "Collection" }, { "type": "text", "id": "title", "label": "Title (optional)" } ] } ],
  "presets": [{ "name": "PKG categories" }]
}
{% endschema %}

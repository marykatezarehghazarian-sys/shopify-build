<section class="section"><div class="wrap split">
  <div>
    <div class="lead rte">{{ section.settings.text | default: page.content }}</div>
    <div class="hero__actions">
      {%- if settings.whatsapp != blank and section.settings.button != blank -%}<a class="btn btn--wa" href="{% render 'wa-url' %}" target="_blank" rel="noopener">{% render 'pkg-icon', name: 'whatsapp' %}{{ section.settings.button }}</a>{%- endif -%}
      {%- if section.settings.button_2 != blank -%}<a class="btn btn--ghost" href="{{ section.settings.link_2 }}">{{ section.settings.button_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="map" style="aspect-ratio:4/3;padding:0">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1200 | image_tag: class: 'cover' }}{% else %}<div><p class="eyebrow">Photo</p><p class="muted">Factory or team photo goes here</p></div>{% endif %}</div>
</div></section>
{% schema %}
{ "name": "PKG text with photo", "settings": [
  { "type": "richtext", "id": "text", "label": "Text (empty = page content)" },
  { "type": "image_picker", "id": "image", "label": "Photo" },
  { "type": "text", "id": "button", "label": "WhatsApp button", "default": "Talk to us" },
  { "type": "text", "id": "button_2", "label": "Second button", "default": "Visit the showroom" }, { "type": "url", "id": "link_2", "label": "Second button link" } ],
  "presets": [{ "name": "PKG text with photo" }] }
{% endschema %}

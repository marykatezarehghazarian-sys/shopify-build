<section class="section"><div class="wrap split" style="align-items:start">
    <div>{%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- if section.settings.text != blank -%}<p class="lead" style="margin-top:16px">{{ section.settings.text }}</p>{%- endif -%}</div>
    <div class="faq">
      {%- for block in section.blocks -%}<details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><p>{{ block.settings.answer }}</p></details>{%- endfor -%}
    </div>
</div></section>
{% schema %}
{
  "name": "PKG FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good questions" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Can't find your answer? Message us on WhatsApp and a real person will reply." }
  ],
  "blocks": [ { "type": "qa", "name": "Question", "settings": [ { "type": "text", "id": "question", "label": "Question", "default": "Question?" }, { "type": "textarea", "id": "answer", "label": "Answer" } ] } ],
  "presets": [{ "name": "PKG FAQ" }]
}
{% endschema %}

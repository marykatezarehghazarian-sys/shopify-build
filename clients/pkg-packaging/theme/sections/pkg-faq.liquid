<section class="section"><div class="wrap faq-wrap">
    <div>{%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2 class="h2 faq__title">{{ section.settings.heading }}</h2>{%- if section.settings.text != blank -%}<p class="lead" style="margin-top:18px;max-width:46ch">{{ section.settings.text }}</p>{%- endif -%}</div>
    <div class="faq">
      {%- for block in section.blocks -%}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><p>{{ block.settings.answer }}</p></details>{%- endfor -%}
    </div>
</div></section>
{% schema %}
{
  "name": "PKG FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Need a specific answer? Message us on WhatsApp and we'll help you with your order." }
  ],
  "blocks": [ { "type": "qa", "name": "Question", "settings": [ { "type": "text", "id": "question", "label": "Question", "default": "Question?" }, { "type": "textarea", "id": "answer", "label": "Answer" } ] } ],
  "presets": [{ "name": "PKG FAQ" }]
}
{% endschema %}

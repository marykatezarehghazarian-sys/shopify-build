<div class="section page-width">
  <h1>{{ 'collections.all' | t }}</h1>
  <div class="grid">
    {%- for collection in collections -%}
      <a class="product-card" href="{{ collection.url }}">
        {%- if collection.featured_image %}{{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}{% endif -%}
        <h3 class="product-card__title">{{ collection.title | escape }}</h3>
      </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}{ "name": "Collections list" }{% endschema %}

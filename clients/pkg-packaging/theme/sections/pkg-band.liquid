<section class="section" style="{% if section.settings.no_top %}padding-top:0{% endif %}"><div class="wrap"><div class="band">
  <div><h2 class="h2">{{ section.settings.heading }}</h2>{%- if section.settings.text != blank -%}<p class="lead" style="margin-top:14px">{{ section.settings.text }}</p>{%- endif -%}</div>
  <div class="band__actions">
    {%- if settings.whatsapp != blank -%}<a class="btn btn--light" href="{% render 'wa-url' %}" target="_blank" rel="noopener">{% render 'pkg-icon', name: 'whatsapp' %}{{ section.settings.button }}</a>{%- endif -%}
    {%- if section.settings.button_2 != blank -%}<a class="btn btn--ghost" style="border-color:#fff;color:#fff" href="{{ section.settings.link_2 }}">{{ section.settings.button_2 }}</a>{%- endif -%}
  </div>
</div></div></section>
{% schema %}
{ "name": "PKG call to action", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "Let's print your next order" },
  { "type": "textarea", "id": "text", "label": "Text", "default": "Send us the product, quantity and your logo. We'll reply with a quote." },
  { "type": "text", "id": "button", "label": "WhatsApp button", "default": "WhatsApp us" },
  { "type": "text", "id": "button_2", "label": "Second button" }, { "type": "url", "id": "link_2", "label": "Second button link" },
  { "type": "checkbox", "id": "no_top", "label": "Remove top spacing", "default": true } ],
  "presets": [{ "name": "PKG call to action" }] }
{% endschema %}

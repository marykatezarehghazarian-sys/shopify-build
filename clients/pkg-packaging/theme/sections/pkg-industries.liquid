<section class="section section--ink"><div class="wrap">
    <div class="section__head">
      <div>{%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2 class="h2">{{ section.settings.heading }}</h2></div>
      {%- if section.settings.text != blank -%}<p class="lead" style="max-width:44ch">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="inds">
      {%- for block in section.blocks -%}
        <div class="ind reveal" {{ block.shopify_attributes }}>{%- if section.settings.show_icons -%}{% render 'pkg-icon', name: block.settings.icon %}{%- else -%}<span class="ind__bar"></span>{%- endif -%}<h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
      {%- endfor -%}
    </div>
</div></section>
{% schema %}
{
  "name": "PKG industries",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Industries we serve" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Printing and packaging for every type of business." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "From one café to a chain of branches, we print the packaging and paperwork your customers see every day." },
    { "type": "checkbox", "id": "show_icons", "label": "Show icons", "default": false }
  ],
  "blocks": [ { "type": "industry", "name": "Industry", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "default": "food", "options": [ { "value": "food", "label": "Box" }, { "value": "bakery", "label": "Cake box" }, { "value": "coffee", "label": "Cup" }, { "value": "bags", "label": "Bag" }, { "value": "labels", "label": "Label" }, { "value": "retail", "label": "Mailer box" }, { "value": "corporate", "label": "Card" }, { "value": "school", "label": "Notebook" } ] },
    { "type": "text", "id": "title", "label": "Title", "default": "Restaurants" },
    { "type": "textarea", "id": "text", "label": "Text" } ] } ],
  "presets": [{ "name": "PKG industries" }]
}
{% endschema %}

{%- liquid
  assign shots = 0
  for block in section.blocks
    if block.settings.image
      assign shots = shots | plus: 1
    endif
  endfor
-%}
<section class="section"><div class="wrap split factory">
  <div>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lead" style="margin-top:18px">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}<div class="hero__actions"><a class="btn btn--ghost" href="{{ section.settings.button_link | default: '/pages/showroom' }}">{{ section.settings.button_label }}</a></div>{%- endif -%}
  </div>
  <div class="factory__grid{% if shots > 1 %} factory__grid--multi{% endif %}">
    {%- for block in section.blocks -%}
      {%- if block.settings.image -%}
      <figure class="factory__shot reveal" {{ block.shopify_attributes }}>
        {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(max-width: 860px) 100vw, 50vw', alt: block.settings.caption }}
        {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
      </figure>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div></section>
{% schema %}
{
  "name": "PKG factory",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Our factory" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Printed in-house, on our own machines" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [ { "type": "machine", "name": "Machine photo", "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Digital printing" } ] } ],
  "max_blocks": 6,
  "presets": [{ "name": "PKG factory" }]
}
{% endschema %}

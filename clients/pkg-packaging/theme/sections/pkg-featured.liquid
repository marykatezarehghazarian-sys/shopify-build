{%- liquid
  assign c = section.settings.collection
  if c == blank
    assign c = collections.all
  endif
-%}
<section class="section"><div class="wrap">
    <div class="section__head"><div>{%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2 class="h2">{{ section.settings.heading }}</h2></div><a class="btn btn--ghost" href="{{ routes.collections_url }}/all">{{ section.settings.button }}</a></div>
    <div class="grid">
      {%- assign shown = 0 -%}
      {%- for product in c.products -%}
        {%- if section.settings.popular_only and section.settings.collection == blank -%}{%- unless product.tags contains 'popular' -%}{%- continue -%}{%- endunless -%}{%- endif -%}
        {%- render 'product-card', product: product -%}
        {%- assign shown = shown | plus: 1 -%}{%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
    </div>
</div></section>
{% schema %}
{
  "name": "PKG featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Best sellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Popular products" },
    { "type": "text", "id": "button", "label": "Button", "default": "See the full catalogue →" },
    { "type": "collection", "id": "collection", "label": "Collection (optional)" },
    { "type": "checkbox", "id": "popular_only", "label": "Without a collection: only products tagged \"popular\"", "default": true },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 16, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "PKG featured products" }]
}
{% endschema %}

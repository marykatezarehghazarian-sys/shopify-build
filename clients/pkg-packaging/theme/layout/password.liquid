<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <style>:root{--ink:{{ settings.color_ink }};--paper:{{ settings.color_paper }};--kraft:{{ settings.color_kraft }};--accent:{{ settings.color_accent }}}</style>
    {{ 'pkg.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>

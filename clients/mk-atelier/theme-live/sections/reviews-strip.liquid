<div class="reviews-strip">
  {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}" class="reviews-strip__inner">{%- else -%}<div class="reviews-strip__inner">{%- endif -%}
    <span>{{ section.settings.title | default: shop.name }} Reviews</span>
    <span class="reviews-strip__stars">
      {%- for i in (1..5) -%}{% render 'icon-star' %}{%- endfor -%}
    </span>
    <span>{{ section.settings.rating }} out of 5</span>
    <span class="reviews-strip__link">Based on {{ section.settings.review_count }} reviews</span>
  {%- if section.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
</div>

{% schema %}
{
  "name": "Reviews strip",
  "settings": [
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 0.1, "default": 4.8 },
    { "type": "number", "id": "review_count", "label": "Review count", "default": 300 },
    { "type": "url", "id": "link", "label": "Link to reviews" }
  ],
  "presets": [{ "name": "Reviews strip" }]
}
{% endschema %}

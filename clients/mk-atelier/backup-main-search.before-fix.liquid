<div class="section container">
  <div class="section-heading"><h1>Search</h1></div>
  {%- form 'search', role: 'search' -%}
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search sculptures, art & decor" style="width:100%; padding:14px; border:1px solid var(--color-border); font-size:15px; margin-bottom:32px;">
  {%- endform -%}
  {%- if search.performed -%}
    <p style="font-size:13px; opacity:0.6; margin-bottom:20px;">{{ search.results_count }} results for "{{ search.terms }}"</p>
    <div class="product-grid">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {% render 'product-card', product: item %}
        {%- else -%}
          <a href="{{ item.url }}" style="grid-column:1/-1;">{{ item.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Search" }
{% endschema %}

{%- comment -%} Centred heading, collection tabs and a 4-across product grid with a button to the active collection. {%- endcomment -%}
<div class="section container mk-tabbed" id="mk-tabbed-{{ section.id }}">
  <div class="mk-head">
    {%- if section.settings.heading != blank -%}<h2 class="mk-title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="mk-sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="mk-tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" class="mk-tab" role="tab" id="mk-tab-{{ block.id }}" aria-controls="mk-panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-url="{{ block.settings.collection.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title }}</button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    <div class="mk-panel" role="tabpanel" id="mk-panel-{{ block.id }}" aria-labelledby="mk-tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
      <div class="product-grid">
        {%- for product in block.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    </div>
  {%- endfor -%}

  {%- assign first = section.blocks.first.settings.collection -%}
  {%- if section.settings.button_label != blank -%}
    <div class="mk-tabbed__cta"><a href="{{ first.url | default: routes.all_products_collection_url }}" class="btn" data-cta>{{ section.settings.button_label }}</a></div>
  {%- endif -%}
</div>
<script>
  (function () {
    var root = document.getElementById('mk-tabbed-{{ section.id }}'); if (!root) return;
    var cta = root.querySelector('[data-cta]');
    root.querySelectorAll('.mk-tab').forEach(function (tab) {
      tab.addEventListener('click', function () {
        root.querySelectorAll('.mk-tab').forEach(function (t) { t.setAttribute('aria-selected', t === tab ? 'true' : 'false'); });
        root.querySelectorAll('.mk-panel').forEach(function (p) { p.hidden = p.id !== tab.getAttribute('aria-controls'); });
        if (cta && tab.dataset.url) cta.href = tab.dataset.url;
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Tabbed products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pieces that hold a room." },
    { "type": "text", "id": "subheading", "label": "Text under the heading" },
    { "type": "range", "id": "products_to_show", "label": "Products per tab", "min": 4, "max": 16, "step": 4, "default": 8 },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Discover the collection" }
  ],
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "label", "label": "Tab label (defaults to the collection name)" }
    ] }
  ],
  "presets": [{ "name": "Tabbed products", "blocks": [{ "type": "tab" }, { "type": "tab" }] }]
}
{% endschema %}

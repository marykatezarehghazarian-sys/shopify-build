{%- comment -%} ===== CHIC CORNER FOOTER — matte black ground, cream text, gold accents ===== {%- endcomment -%}
{%- assign cc_text   = settings.color_palette.background | default: '#EFE7D8' -%}
{%- assign cc_accent = settings.color_palette.color3     | default: '#9C7A4D' -%}
{%- assign wa_number = '+96179039166' -%}

{%- comment -%} Marquee {%- endcomment -%}
<div class="cc-marquee" aria-hidden="true">
  <div class="cc-marquee__track">
    {%- for i in (1..8) -%}
      <span>BUY MORE, SAVE MORE</span><span class="cc-marquee__dot">✦</span><span>AUTHENTIC LUXURY ACCESSORIES</span><span class="cc-marquee__dot">✦</span><span>CASH ON DELIVERY IN LEBANON</span><span class="cc-marquee__dot">✦</span>
    {%- endfor -%}
  </div>
</div>

{%- comment -%} Newsletter {%- endcomment -%}
<div class="cc-news">
  <div class="cc-news__inner">
    <p class="cc-news__eyebrow">JOIN THE LIST</p>
    <h2 class="cc-news__title">The Chic Corner list</h2>
    <p class="cc-news__sub">Exclusive drops, offers and styling tips — straight to your inbox.</p>
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="cc-news__row">
        <input type="email" name="contact[email]" placeholder="Your email address" aria-label="Email address" required>
        <button type="submit">Subscribe</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="cc-news__ok">Thanks for joining the Chic Corner list ✦</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{%- comment -%} Main footer {%- endcomment -%}
<div class="cc-footer">
  <div class="cc-footer__inner">
    <div class="cc-footer__brand">
      <h2 class="cc-footer__logo">Chic Corner</h2>
      <p class="cc-footer__tag">Curated luxury accessories for men &amp; women. Authentic pieces delivered across Lebanon.</p>
      <div class="cc-footer__social">
        <a href="https://instagram.com/" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
        <a href="https://tiktok.com/" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M16 3c.3 2.2 1.6 3.9 3.9 4.1v2.7c-1.4.1-2.7-.3-3.9-1v6.3c0 3.5-2.8 6-6 6a5.7 5.7 0 1 1 1.5-11.2v2.9a2.9 2.9 0 1 0 2 2.7V3z"/></svg></a>
        <a href="https://wa.me/{{ wa_number }}" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.82 9.82 0 001.599 5.31l-.999 3.648 3.899-1.017zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.767.967-.94 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg></a>
      </div>
    </div>
    <div class="cc-footer__col">
      <h3 class="cc-footer__head">Shop</h3>
      <a href="/collections/sunglasses">Sunglasses</a>
      <a href="/collections/caps">Caps</a>
      <a href="/collections/perfumes">Perfumes</a>
      <a href="/collections/wallets">Wallets</a>
      <a href="/collections/bracelet">Bracelets</a>
    </div>
    <div class="cc-footer__col">
      <h3 class="cc-footer__head">Customer Care</h3>
      <a href="/search">Search</a>
      <a href="/#shopify-section-template--17360032596023__faq_section">FAQ</a>
      <a href="https://wa.me/{{ wa_number }}" target="_blank" rel="noopener">Contact us</a>
    </div>
    <div class="cc-footer__col">
      <h3 class="cc-footer__head">Company</h3>
      <a href="/pages/build-your-order?view=build-your-order">Build your order</a>
      <a href="/pages/collaborate?view=collaborate">Collaborate</a>
      <a href="/collections/all">All products</a>
    </div>
  </div>

  {%- comment -%} Promise row {%- endcomment -%}
  <div class="cc-footer__promise">
    <span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg> Cash on delivery</span>
    <span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8a8 8 0 0 1 14-4l3 3"/><path d="M20 4v4h-4"/><path d="M21 16a8 8 0 0 1-14 4l-3-3"/><path d="M4 20v-4h4"/></svg> 72-hour exchange</span>
    <span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1" y="6" width="14" height="10" rx="1"/><path d="M15 9h4l3 3v4h-7z"/><circle cx="6" cy="18" r="1.6"/><circle cx="18" cy="18" r="1.6"/></svg> 1–3 day delivery</span>
  </div>

  <div class="cc-footer__pay">
    {% render 'cc-payments' %}
  </div>

  <div class="cc-footer__bottom">
    <span>Beirut, Lebanon</span>
    <a href="https://wa.me/{{ wa_number }}">+961 79 039 166</a>
    <span class="cc-footer__copy">© 2026 Chic Corner</span>
  </div>
</div>

{%- comment -%} Floating WhatsApp {%- endcomment -%}
<a class="cc-wa-float" href="https://wa.me/{{ wa_number }}" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <svg viewBox="0 0 24 24" width="30" height="30" fill="#fff"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.82 9.82 0 001.599 5.31l-.999 3.648 3.899-1.017zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.767.967-.94 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
</a>

<style>
.cc-marquee{background:{{ cc_accent }};overflow:hidden;padding:11px 0;white-space:nowrap;}
.cc-marquee__track{display:inline-block;animation:cc-marq 40s linear infinite;}
.cc-marquee__track span{color:#1C1714;font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;padding:0 18px;}
.cc-marquee__dot{opacity:.6;}
@keyframes cc-marq{from{transform:translateX(0);}to{transform:translateX(-50%);}}

.cc-news{background:#211B17;padding:70px 24px;text-align:center;}
.cc-news__inner{max-width:560px;margin:0 auto;}
.cc-news__eyebrow{color:{{ cc_accent }};font-size:12px;letter-spacing:.24em;font-weight:600;margin:0 0 14px;}
.cc-news__title{font-family:var(--font-primary--family,serif);color:{{ cc_text }};font-size:40px;line-height:1.05;margin:0 0 14px;font-weight:500;}
.cc-news__sub{color:color-mix(in srgb,{{ cc_text }} 66%,transparent);font-size:15px;line-height:1.6;margin:0 0 28px;}
.cc-news__row{display:flex;gap:0;border:1px solid color-mix(in srgb,{{ cc_text }} 26%,transparent);border-radius:999px;padding:6px;background:transparent;}
.cc-news__row input{flex:1;background:transparent;border:none;outline:none;color:{{ cc_text }};padding:12px 20px;font-size:15px;}
.cc-news__row input::placeholder{color:color-mix(in srgb,{{ cc_text }} 45%,transparent);}
.cc-news__row button{background:{{ cc_accent }};color:#1C1714;border:none;border-radius:999px;padding:12px 26px;font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:600;cursor:pointer;transition:filter .2s;}
.cc-news__row button:hover{filter:brightness(1.08);}
.cc-news__ok{color:{{ cc_accent }};margin:16px 0 0;font-size:14px;}

.cc-footer{background:#1C1714;color:{{ cc_text }};padding:64px 24px 28px;}
.cc-footer__inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr;gap:44px;}
.cc-footer__logo{font-family:var(--font-primary--family,serif);color:{{ cc_text }};font-size:34px;line-height:1;margin:0 0 16px;font-weight:500;}
.cc-footer__tag{color:color-mix(in srgb,{{ cc_text }} 62%,transparent);max-width:380px;line-height:1.7;font-size:15px;margin:0 0 22px;}
.cc-footer__social{display:flex;gap:12px;}
.cc-footer__social a{width:40px;height:40px;border-radius:50%;border:1px solid color-mix(in srgb,{{ cc_text }} 26%,transparent);display:flex;align-items:center;justify-content:center;color:{{ cc_text }};transition:all .2s;}
.cc-footer__social a:hover{background:{{ cc_accent }};border-color:{{ cc_accent }};color:#1C1714;}
.cc-footer__head{color:{{ cc_text }};font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;margin:0 0 14px;}
.cc-footer__col a{display:block;color:color-mix(in srgb,{{ cc_text }} 60%,transparent);text-decoration:none;padding:9px 0;font-size:15px;transition:color .2s;}
.cc-footer__col a:hover{color:{{ cc_accent }};}
.cc-footer__promise{max-width:1200px;margin:52px auto 0;padding:26px 0;border-top:1px solid color-mix(in srgb,{{ cc_text }} 14%,transparent);border-bottom:1px solid color-mix(in srgb,{{ cc_text }} 14%,transparent);display:flex;flex-wrap:wrap;justify-content:center;gap:14px 42px;}
.cc-footer__promise span{display:inline-flex;align-items:center;gap:9px;color:color-mix(in srgb,{{ cc_text }} 72%,transparent);font-size:14px;}
.cc-footer__promise svg{color:{{ cc_accent }};}
.cc-footer__pay{max-width:1200px;margin:22px auto 0;color:{{ cc_text }};}
.cc-footer__bottom{max-width:1200px;margin:20px auto 0;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;color:color-mix(in srgb,{{ cc_text }} 55%,transparent);font-size:13px;}
.cc-footer__bottom a{color:color-mix(in srgb,{{ cc_text }} 70%,transparent);text-decoration:none;}
.cc-footer__bottom a:hover{color:{{ cc_accent }};}
.cc-wa-float{position:fixed;right:20px;bottom:20px;width:58px;height:58px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0,0,0,.3);z-index:9998;}
@media(min-width:750px){.cc-footer__inner{grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;}}
@media(max-width:749px){.cc-news__title{font-size:30px;}.cc-news{padding:50px 24px;}.cc-footer__bottom{justify-content:center;text-align:center;}}
</style>

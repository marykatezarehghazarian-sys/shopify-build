<style>
.cc-ft{background:#fff;color:#121212;border-top:1px solid #e6e6e6;padding:8px 16px 28px;font-size:14px;}
.cc-ft__cols{max-width:1200px;margin:0 auto;}
.cc-ft__item{border-bottom:1px solid #e6e6e6;}
.cc-ft__item summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;padding:18px 0;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;}
.cc-ft__item summary::-webkit-details-marker{display:none;}
.cc-ft__icon{transition:transform .2s;}
.cc-ft__item[open] .cc-ft__icon{transform:rotate(45deg);}
.cc-ft__links{padding:0 0 18px;}
.cc-ft__links a{display:block;color:#121212;opacity:.75;text-decoration:none;padding:6px 0;}
.cc-ft__links a:hover{opacity:1;}
.cc-ft__text p,.cc-ft__note{margin:0 0 8px;opacity:.75;line-height:1.55;}
.cc-ft__social{display:flex;gap:10px;}
.cc-ft__social a{width:40px;height:40px;border:1px solid #d9d9d9;border-radius:50%;display:flex !important;align-items:center;justify-content:center;opacity:1;padding:0;}
.cc-ft__form{display:flex;gap:8px;flex-wrap:wrap;}
.cc-ft__form input[type=email]{flex:1 1 180px;border:1px solid #cfcfcf;padding:12px 14px;font-size:14px;background:#fff;color:#121212;}
.cc-ft__form button{background:#121212;color:#fff;border:0;padding:12px 18px;font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;}
.cc-ft__brand{text-align:center;padding:34px 0 0;}
.cc-ft__logo{font-family:var(--font-heading--family);font-size:30px;font-weight:500;letter-spacing:-.01em;margin:0 0 6px;}
.cc-ft__tag{margin:0 0 16px;opacity:.7;}
.cc-ft__pay{display:flex;justify-content:center;margin:0 0 14px;color:#121212;}
.cc-ft__small{margin:0;font-size:12px;opacity:.6;}
.cc-ft__small a{color:inherit;}
.cc-wa-float{position:fixed;right:20px;bottom:20px;width:58px;height:58px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0,0,0,.3);z-index:9998;}
@media(min-width:750px){
  .cc-ft{padding:48px 32px 32px;}
  .cc-ft__cols{display:grid;grid-template-columns:repeat(6,1fr);gap:28px;}
  .cc-ft__item{border:0;}
  .cc-ft__item summary{pointer-events:none;padding:0 0 14px;}
  .cc-ft__icon{display:none;}
  .cc-ft__brand{border-top:1px solid #e6e6e6;margin-top:36px;}
}
</style>

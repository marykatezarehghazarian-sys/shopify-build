<script>
  (function () {
    var mq = window.matchMedia('(min-width: 750px)');
    function sync() { document.querySelectorAll('.cc-ft__item').forEach(function (d) { if (mq.matches) d.setAttribute('open', ''); else d.removeAttribute('open'); }); }
    sync(); mq.addEventListener ? mq.addEventListener('change', sync) : mq.addListener(sync);
  })();
</script>


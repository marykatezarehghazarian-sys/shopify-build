{%- comment -%} ===== CHIC CORNER — top announcement marquee ===== {%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_color | default: '#9C7A4D'
  assign fg = section.settings.text_color | default: '#1C1714'
  assign speed = section.settings.speed | default: 34
-%}

<div class="cc-topmarq" style="--cc-mbg: {{ bg }}; --cc-mfg: {{ fg }}; --cc-mspeed: {{ speed }}s;">
  <div class="cc-topmarq__track">
    {%- for i in (1..10) -%}
      {%- for block in section.blocks -%}
        <span class="cc-topmarq__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        <span class="cc-topmarq__dot">✦</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .cc-topmarq { background: var(--cc-mbg); overflow: hidden; white-space: nowrap; padding: 9px 0; }
  .cc-topmarq__track { display: inline-block; animation: cc-topmarq-scroll var(--cc-mspeed) linear infinite; }
  .cc-topmarq__item { color: var(--cc-mfg); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; font-weight: 600; padding: 0 16px; }
  .cc-topmarq__dot { color: var(--cc-mfg); opacity: .55; }
  @keyframes cc-topmarq-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Top Marquee",
  "tag": "section",
  "class": "cc-topmarq-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#9C7A4D" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1714" },
    { "type": "range", "id": "speed", "label": "Scroll speed (s)", "min": 10, "max": 80, "step": 2, "default": 34, "unit": "s" }
  ],
  "blocks": [
    { "type": "message", "name": "Message", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Cash on delivery in Lebanon" } ] }
  ],
  "presets": [
    {
      "name": "Top Marquee",
      "blocks": [
        { "type": "message", "settings": { "text": "Spend $49 → 10% off" } },
        { "type": "message", "settings": { "text": "Spend $75 → 15% off" } },
        { "type": "message", "settings": { "text": "Spend $100 → 20% off + free gift" } },
        { "type": "message", "settings": { "text": "Cash on delivery across Lebanon" } }
      ]
    }
  ]
}
{% endschema %}

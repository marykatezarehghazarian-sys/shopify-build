{%- comment -%} ===== CHIC CORNER — Collaborate / creator page ===== {%- endcomment -%}
{%- liquid
  assign accent = settings.color_palette.color3 | default: '#9C7A4D'
  assign s = section.settings
-%}

<div class="cc-collab" style="--cc-accent: {{ accent }};">
  <div class="cc-collab__head">
    <p class="cc-collab__eyebrow">{{ s.eyebrow }}</p>
    <h1 class="cc-collab__title">{{ s.heading }}</h1>
    <p class="cc-collab__sub">{{ s.subheading }}</p>
  </div>

  <div class="cc-collab__grid">
    <div class="cc-collab__formwrap">
      {%- form 'contact', id: 'cc-collab-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="cc-collab__ok">Thank you! Your collaboration request is in — our team will reach out soon. ✦</p>
        {%- endif -%}
        <div class="cc-collab__row2">
          <div class="cc-collab__field">
            <label>Full name <span>*</span></label>
            <input type="text" name="contact[name]" placeholder="Your first and last name" required>
          </div>
          <div class="cc-collab__field">
            <label>Email <span>*</span></label>
            <input type="email" name="contact[email]" placeholder="you@email.com" required>
          </div>
        </div>
        <div class="cc-collab__row2">
          <div class="cc-collab__field">
            <label>Phone / WhatsApp</label>
            <input type="tel" name="contact[Phone]" placeholder="+961 ...">
          </div>
          <div class="cc-collab__field">
            <label>Type of collaboration</label>
            <select name="contact[Type of collaboration]">
              <option>Influencer / Content creator</option>
              <option>Affiliate / Discount code</option>
              <option>Wholesale / Reseller</option>
              <option>Brand partnership</option>
              <option>Other</option>
            </select>
          </div>
        </div>
        <div class="cc-collab__field">
          <label>Tell us about you</label>
          <textarea name="contact[body]" rows="5" placeholder="Share your social handles, your community size, and why you'd love to work with Chic Corner."></textarea>
        </div>
        <button type="submit" class="cc-collab__submit">Send my collaboration request</button>
      {%- endform -%}
    </div>

    <div class="cc-collab__why">
      <h2 class="cc-collab__whytitle">{{ s.why_heading }}</h2>
      {%- for block in section.blocks -%}
        <div class="cc-collab__benefit" {{ block.shopify_attributes }}>
          <span class="cc-collab__bicon">
            {%- case block.settings.icon -%}
              {%- when 'money' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5a2.5 2 0 0 1 5 0c0 1.5-5 1-5 3a2.5 2 0 0 0 5 0"/></svg>
              {%- when 'tag' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 12l-8 8-9-9V3h8z"/><circle cx="7.5" cy="7.5" r="1.3"/></svg>
              {%- when 'star' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 12v9H4v-9M2 7h20v5H2zM12 22V7M12 7S9 2 6.5 3.5 8 7 12 7zM12 7s3-5 5.5-3.5S16 7 12 7z"/></svg>
            {%- endcase -%}
          </span>
          <div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .cc-collab-section { background: #FBF9F4; }
  .cc-collab { max-width: 1160px; margin: 0 auto; padding: 60px 24px 80px; background: #FBF9F4; }
  .cc-collab__head { text-align: center; margin-bottom: 48px; }
  .cc-collab__eyebrow { color: var(--cc-accent); letter-spacing: .22em; font-size: 12px; font-weight: 600; margin: 0 0 12px; }
  .cc-collab__title { font-family: var(--font-primary--family, serif); font-size: clamp(34px, 5vw, 56px); line-height: 1.05; margin: 0 0 16px; color: #1C1714; }
  .cc-collab__sub { max-width: 620px; margin: 0 auto; color: #6e655a; line-height: 1.6; font-size: 16px; }
  .cc-collab__grid { display: grid; grid-template-columns: 1fr; gap: 48px; }
  .cc-collab__formwrap { background: color-mix(in srgb, var(--cc-accent) 7%, #fff); border: 1px solid color-mix(in srgb, var(--cc-accent) 22%, transparent); border-radius: 20px; padding: 34px; }
  .cc-collab__row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .cc-collab__field { margin-bottom: 18px; display: flex; flex-direction: column; }
  .cc-collab__field label { font-size: 14px; font-weight: 600; margin-bottom: 8px; color: #1C1714; }
  .cc-collab__field label span { color: var(--cc-accent); }
  .cc-collab__field input, .cc-collab__field select, .cc-collab__field textarea {
    border: 1px solid rgba(28,23,20,0.18);
    border-radius: 12px; padding: 13px 15px; font-size: 15px; background: #fff;
    color: #1C1714; font-family: inherit; width: 100%;
  }
  .cc-collab__field input:focus, .cc-collab__field select:focus, .cc-collab__field textarea:focus { outline: none; border-color: var(--cc-accent); }
  .cc-collab__submit { background: #1C1714; color: #F4EEE4; border: none; border-radius: 999px; padding: 16px 32px; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; cursor: pointer; width: 100%; margin-top: 6px; transition: opacity .2s; }
  .cc-collab__submit:hover { opacity: .88; }
  .cc-collab__ok { background: color-mix(in srgb, var(--cc-accent) 16%, #fff); border: 1px solid var(--cc-accent); color: #1C1714; padding: 14px 16px; border-radius: 12px; margin: 0 0 22px; font-size: 14px; }
  .cc-collab__whytitle { font-family: var(--font-primary--family, serif); font-size: 30px; margin: 0 0 28px; color: #1C1714; }
  .cc-collab__benefit { display: flex; gap: 16px; padding: 18px 0; border-bottom: 1px solid rgba(28,23,20,0.1); }
  .cc-collab__bicon { flex: 0 0 auto; width: 44px; height: 44px; border-radius: 50%; background: color-mix(in srgb, var(--cc-accent) 14%, transparent); display: flex; align-items: center; justify-content: center; color: var(--cc-accent); }
  .cc-collab__bicon svg { width: 20px; height: 20px; }
  .cc-collab__benefit h3 { margin: 2px 0 5px; font-size: 17px; color: #1C1714; }
  .cc-collab__benefit p { margin: 0; font-size: 14px; line-height: 1.5; color: #6e655a; }
  @media (min-width: 900px) { .cc-collab__grid { grid-template-columns: 1.1fr .9fr; gap: 64px; align-items: start; } }
  @media (max-width: 600px) { .cc-collab__row2 { grid-template-columns: 1fr; } .cc-collab__formwrap { padding: 22px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Chic Corner Collab",
  "tag": "section",
  "class": "cc-collab-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "LET'S CREATE TOGETHER ✦" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Chic Corner creator family" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Are you a creator, influencer or partner who loves accessories? Fill in the form and our team will craft a collaboration made for you." },
    { "type": "text", "id": "why_heading", "label": "Why heading", "default": "Why create with us" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "money", "options": [
          { "value": "money", "label": "Money" },
          { "value": "tag", "label": "Tag" },
          { "value": "star", "label": "Star" },
          { "value": "gift", "label": "Gift" }
        ]},
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this benefit." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chic Corner Collab",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "money", "title": "Earn on every sale", "text": "Enjoy a generous commission on every order made through your personal link or code." } },
        { "type": "benefit", "settings": { "icon": "tag", "title": "Your own discount code", "text": "Give your community an exclusive discount with a promo code in your name." } },
        { "type": "benefit", "settings": { "icon": "star", "title": "Featured on our channels", "text": "We reshare and tag your content across Chic Corner's social platforms." } },
        { "type": "benefit", "settings": { "icon": "gift", "title": "Gifts & long-term partnerships", "text": "PR packages, early access to drops and the chance to co-create with us." } }
      ]
    }
  ]
}
{% endschema %}

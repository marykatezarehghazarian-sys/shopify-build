        "custom_liquid_Hcn4jV": {
          "type": "custom_liquid",
          "settings": {
            "column_placement": "right",
            "custom_liquid": "{% assign current_variant = product.selected_or_first_available_variant %}\n{% assign qty = current_variant.inventory_quantity %}\n\n{% if current_variant.inventory_management == blank %}\n  {% assign stock_state = 'in-stock' %}\n{% elsif qty <= 0 %}\n  {% assign stock_state = 'out-stock' %}\n{% elsif qty < 3 %}\n  {% assign stock_state = 'low-stock' %}\n{% else %}\n  {% assign stock_state = 'in-stock' %}\n{% endif %}\n\n<div class=\"shopica-stock-card {{ stock_state }}\">\n\n  <div class=\"shopica-stock-content\">\n\n    {% if stock_state == 'out-stock' %}\n\n      <div class=\"shopica-stock-heading\">\n        <span class=\"shopica-stock-dot\"></span>\n        <span><strong>Out of stock</strong></span>\n      </div>\n\n    {% elsif stock_state == 'low-stock' %}\n\n      <div class=\"shopica-stock-heading\">\n        <span class=\"shopica-stock-dot\"></span>\n\n        {% if qty == 1 %}\n          <span><strong>Only 1 left in stock</strong></span>\n        {% else %}\n          <span><strong>Only {{ qty }} left in stock</strong></span>\n        {% endif %}\n      </div>\n\n      <div class=\"shopica-stock-subtext\">\n        Order soon — limited stock available.\n      </div>\n\n    {% else %}\n\n      <div class=\"shopica-stock-heading\">\n        <span class=\"shopica-stock-dot\"></span>\n        <span><strong>In stock,</strong> ready to ship</span>\n      </div>\n\n      <div class=\"shopica-stock-subtext\">\n        Dispatched from Sydney warehouse within <strong> 3 business days. </strong>\n      </div>\n\n    {% endif %}\n\n  </div>\n\n  {% unless stock_state == 'out-stock' %}\n    <div class=\"shopica-stock-icon\">\n      <svg width=\"25\" height=\"25\" viewBox=\"0 0 24 24\" fill=\"none\">\n        <path d=\"M3 6H14V16H3V6Z\"\n          stroke=\"currentColor\" stroke-width=\"1.5\"/>\n        <path d=\"M14 10H18L21 13V16H14V10Z\"\n          stroke=\"currentColor\" stroke-width=\"1.5\"/>\n        <circle cx=\"7\" cy=\"17.5\" r=\"1.5\"\n          stroke=\"currentColor\" stroke-width=\"1.5\"/>\n        <circle cx=\"18\" cy=\"17.5\" r=\"1.5\"\n          stroke=\"currentColor\" stroke-width=\"1.5\"/>\n      </svg>\n    </div>\n  {% endunless %}\n\n</div>\n\n<style>\n\n.shopica-stock-card {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 15px;\n\n  padding: 14px 16px;\n  margin: 10px 0 16px;\n\n  border-radius: 7px;\n  border: 1px solid;\n}\n\n.shopica-stock-heading {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n\n  font-size: 14px;\n  line-height: 1.4;\n}\n\n.shopica-stock-heading strong {\n  font-weight: 600;\n}\n\n.shopica-stock-dot {\n  width: 9px;\n  height: 9px;\n  min-width: 9px;\n  border-radius: 50%;\n}\n\n.shopica-stock-subtext {\n  margin-top: 4px;\n  margin-left: 18px;\n  font-size: 12.5px;\n  line-height: 1.4;\n}\n\n.shopica-stock-icon {\n  flex-shrink: 0;\n}\n\n\n/* IN STOCK */\n\n.shopica-stock-card.in-stock {\n  background: #eaf5ea !important;\n  border-color: #bfd8bf !important;\n}\n\n.shopica-stock-card.in-stock .shopica-stock-dot {\n  background: #4c9a4b;\n}\n\n.shopica-stock-card.in-stock .shopica-stock-heading {\n  color: #344639;\n}\n\n.shopica-stock-card.in-stock .shopica-stock-heading strong {\n  color: #377b3d;\n}\n\n.shopica-stock-card.in-stock .shopica-stock-subtext {\n  color: #626b64;\n}\n\n.shopica-stock-card.in-stock .shopica-stock-icon {\n  color: #4f6655;\n}\n\n\n/* LOW STOCK — 1 OR 2 */\n\n.shopica-stock-card.low-stock {\n  background: #fff8ed;\n  border-color: #ecd9b9;\n}\n\n.shopica-stock-card.low-stock .shopica-stock-dot {\n  background: #d59233;\n}\n\n.shopica-stock-card.low-stock .shopica-stock-heading {\n  color: #765520;\n}\n\n.shopica-stock-card.low-stock .shopica-stock-heading strong {\n  color: #a36919;\n}\n\n.shopica-stock-card.low-stock .shopica-stock-subtext {\n  color: #776951;\n}\n\n.shopica-stock-card.low-stock .shopica-stock-icon {\n  color: #a87934;\n}\n\n\n/* OUT OF STOCK */\n\n.shopica-stock-card.out-stock {\n  background: #fff4f4;\n  border-color: #ead1d1;\n}\n\n.shopica-stock-card.out-stock .shopica-stock-dot {\n  background: #b94c4c;\n}\n\n.shopica-stock-card.out-stock .shopica-stock-heading {\n  color: #8e3e3e;\n}\n\n.shopica-stock-card.out-stock .shopica-stock-heading strong {\n  color: #9f3f3f;\n}\n\n\n@media screen and (max-width: 749px) {\n\n  .shopica-stock-card {\n    padding: 13px 14px;\n  }\n\n  .shopica-stock-heading {\n    font-size: 14px;\n  }\n\n  .shopica-stock-subtext {\n    font-size: 12px;\n  }\n\n}\n\n</style>"
          }

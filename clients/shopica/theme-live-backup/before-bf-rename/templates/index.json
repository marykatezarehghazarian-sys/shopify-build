      "blocks": {
        "text_79h6Qp": {
          "type": "text",
          "settings": {
            "text": "<p>Australian homes are lived in differently to European or American homes. Open plan living and dining spaces that need furniture to work from multiple angles. North facing windows that flood rooms with afternoon light and show every flaw in a poorly finished mirror or lamp. Outdoor areas that face salt air, UV exposure and temperature extremes that destroy lesser materials within a season. We source with all of this in mind.</p>",
            "text_font_size": 3
          }
        }
      },

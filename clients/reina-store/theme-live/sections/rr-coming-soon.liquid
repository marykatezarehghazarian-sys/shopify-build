{%- comment -%}
  Reina Reichouni "New Arrivals / Coming soon": a grid of pieces. With a label ("Coming soon") they are
  teasers; with the label emptied and a link per piece they point to the live products.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="rr-cs" id="rr-cs-{{ section.id }}">
  <span id="new-arrivals" class="rr-cs__anchor" aria-hidden="true"></span>
  <div class="rr-cs__head">
    {%- if s.eyebrow != blank %}<p class="rr-cs__eyebrow">{{ s.eyebrow | escape }}</p>{% endif -%}
    {%- if s.heading != blank %}<h2 class="rr-cs__heading">{{ s.heading | escape }}</h2>{% endif -%}
  </div>
  <ul class="rr-cs__grid" role="list">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <li class="rr-cs__item" {{ block.shopify_attributes }}>
        {%- if b.link != blank %}<a class="rr-cs__link" href="{{ b.link }}">{% else %}<div class="rr-cs__link">{% endif -%}
          <span class="rr-cs__media">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(min-width: 990px) 30vw, 50vw', class: 'rr-cs__img', alt: b.image.alt }}
            {%- endif -%}
            {%- assign badge = b.badge | default: s.badge -%}
            {%- if badge != blank %}<span class="rr-cs__badge">{{ badge | escape }}</span>{% endif -%}
          </span>
          {%- if b.title != blank %}<span class="rr-cs__title">{{ b.title | escape }}</span>{% endif -%}
        {%- if b.link != blank %}</a>{% else %}</div>{% endif -%}
      </li>
    {%- endfor -%}
  </ul>
  {%- if s.link_label != blank and s.link != blank %}
    <p class="rr-cs__more"><a href="{{ s.link }}">{{ s.link_label | escape }}</a></p>
  {%- endif %}
</section>
<style>
  #rr-cs-{{ section.id }} { padding: {{ s.padding_top }}px max(16px, 2.2vw) {{ s.padding_bottom }}px; color: var(--rr-ink, currentColor); }
  #rr-cs-{{ section.id }} { position: relative; }
  #rr-cs-{{ section.id }} .rr-cs__anchor { position: absolute; top: -80px; }
  #rr-cs-{{ section.id }} .rr-cs__head { text-align: center; margin-bottom: 28px; }
  #rr-cs-{{ section.id }} .rr-cs__eyebrow { margin: 0 0 8px; font: 400 11px var(--rr-sans, inherit); letter-spacing: .18em; text-transform: uppercase; opacity: .75; }
  #rr-cs-{{ section.id }} .rr-cs__heading { margin: 0; font-family: var(--rr-serif, inherit); font-style: italic; font-weight: 400; font-size: clamp(1.7rem, 3vw, 2.5rem); color: inherit; }
  #rr-cs-{{ section.id }} .rr-cs__grid { display: grid; grid-template-columns: repeat({{ s.columns }}, minmax(0, 1fr)); gap: 28px 8px; margin: 0; padding: 0; list-style: none; }
  #rr-cs-{{ section.id }} .rr-cs__link { display: grid; gap: 8px; color: inherit; text-decoration: none; }
  #rr-cs-{{ section.id }} .rr-cs__media { position: relative; display: block; aspect-ratio: 3 / 4; overflow: hidden; background: {{ s.photo_bg }}; }
  #rr-cs-{{ section.id }} .rr-cs__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 6%; transition: transform 1.2s cubic-bezier(.22, 1, .36, 1); }
  @media (hover: hover) { #rr-cs-{{ section.id }} .rr-cs__item:hover .rr-cs__img { transform: scale(1.04); } }
  #rr-cs-{{ section.id }} .rr-cs__badge { position: absolute; left: 10px; top: 10px; padding: 4px 8px; background: rgb(255 255 255 / .9); color: #111; font: 400 10px var(--rr-sans, inherit); letter-spacing: .14em; text-transform: uppercase; }
  #rr-cs-{{ section.id }} .rr-cs__title { font: 400 11px/1.4 var(--rr-sans, inherit); letter-spacing: .08em; text-transform: uppercase; }
  #rr-cs-{{ section.id }} .rr-cs__more { margin: 32px 0 0; text-align: center; }
  #rr-cs-{{ section.id }} .rr-cs__more a { color: inherit; font: 400 11px var(--rr-sans, inherit); letter-spacing: .18em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 4px; }
  @media (max-width: 989px) { #rr-cs-{{ section.id }} .rr-cs__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 749px) { #rr-cs-{{ section.id }} .rr-cs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 6px; } }
</style>
{% schema %}
{
  "name": "RR: coming soon",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The new drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "text", "id": "badge", "label": "Label on each piece", "default": "Coming soon" },
    { "type": "text", "id": "link_label", "label": "Link under the grid" },
    { "type": "url", "id": "link", "label": "Link URL" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "color", "id": "photo_bg", "label": "Photo background", "default": "#f6f4f1" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    { "type": "piece", "name": "Piece", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "title", "label": "Name (optional)" },
      { "type": "text", "id": "badge", "label": "Label (leave empty for the section label)" },
      { "type": "url", "id": "link", "label": "Link (when it's on sale)" }
    ] }
  ],
  "presets": [{ "name": "RR: coming soon" }]
}
{% endschema %}

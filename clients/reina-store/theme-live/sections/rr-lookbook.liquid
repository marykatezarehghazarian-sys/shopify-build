{%- comment -%}
  Reina Reichouni lookbook strip: a sideways-scrolling row of campaign photos. "Photo" blocks come first
  (e.g. the newest campaign), then each product's second photo from the chosen collection, each linking to its piece. Drag/swipe or scroll; no arrows, Khaite/Toteme style.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="rr-look" id="rr-look-{{ section.id }}">
  <div class="rr-look__head">
    {%- if s.heading != blank %}<h2 class="rr-look__heading">{{ s.heading | escape }}</h2>{% endif -%}
    {%- if s.link_label != blank and s.link != blank %}<a class="rr-look__all" href="{{ s.link }}">{{ s.link_label | escape }}</a>{%- elsif s.collection != blank and s.link_label != blank %}<a class="rr-look__all" href="{{ s.collection.url }}">{{ s.link_label | escape }}</a>{% endif -%}
  </div>
  <ul class="rr-look__track" role="list">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      {%- if b.image != blank -%}
        <li class="rr-look__item" {{ block.shopify_attributes }}>
          <a href="{{ b.link | default: s.collection.url | default: '#' }}" class="rr-look__link">
            {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 22vw, 60vw', class: 'rr-look__img', alt: b.image.alt }}
            {%- if b.caption != blank %}<span class="rr-look__cap">{{ b.caption | escape }}</span>{% endif -%}
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
    {%- for product in s.collection.products limit: s.limit -%}
      {%- assign m = product.media[1] | default: product.media[0] -%}
      {%- if m -%}
        <li class="rr-look__item">
          <a href="{{ product.url }}" class="rr-look__link">
            {{ m | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 22vw, 60vw', class: 'rr-look__img', alt: product.title }}
            <span class="rr-look__cap">{{ product.title | escape }}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</section>
<style>
  #rr-look-{{ section.id }} { padding: var(--rr-space-8) 0; color: var(--rr-ink); }
  #rr-look-{{ section.id }} .rr-look__head { display: flex; justify-content: space-between; align-items: flex-end; padding: 0 max(16px, 2.2vw) var(--rr-space-5); }
  #rr-look-{{ section.id }} .rr-look__heading { margin: 0; font-family: var(--rr-serif); font-style: italic; font-weight: 400; font-size: var(--rr-display-sm); color: inherit; }
  #rr-look-{{ section.id }} .rr-look__all { font: 400 var(--rr-text-xs) var(--rr-sans); letter-spacing: .14em; text-transform: uppercase; color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  #rr-look-{{ section.id }} .rr-look__track { display: flex; gap: 6px; margin: 0; padding: 0 max(16px, 2.2vw); list-style: none; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; cursor: grab; }
  #rr-look-{{ section.id }} .rr-look__track::-webkit-scrollbar { display: none; }
  #rr-look-{{ section.id }} .rr-look__item { flex: 0 0 clamp(220px, 22vw, 340px); scroll-snap-align: start; }
  #rr-look-{{ section.id }} .rr-look__link { position: relative; display: block; aspect-ratio: 3 / 4; overflow: hidden; background: var(--rr-surface); color: #fff; text-decoration: none; }
  #rr-look-{{ section.id }} .rr-look__img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--rr-ease-out); }
  #rr-look-{{ section.id }} .rr-look__cap { position: absolute; left: 12px; bottom: 12px; font: 400 var(--rr-text-xs) var(--rr-sans); letter-spacing: .12em; text-transform: uppercase; opacity: 0; transform: translateY(6px); transition: opacity .4s, transform .4s var(--rr-ease-out); text-shadow: 0 1px 8px rgb(0 0 0 / .4); }
  @media (hover: hover) { #rr-look-{{ section.id }} .rr-look__link:hover .rr-look__img { transform: scale(1.05); } #rr-look-{{ section.id }} .rr-look__link:hover .rr-look__cap { opacity: 1; transform: none; } }
  @media (hover: none) { #rr-look-{{ section.id }} .rr-look__cap { opacity: 1; transform: none; } #rr-look-{{ section.id }} .rr-look__item { flex-basis: 62vw; } }
</style>

{%- if s.autoplay %}
<script>
  // Lookbook autoplay: glides continuously from page load and loops seamlessly (photos repeated once
  // behind the scenes). Pauses on hover, touch, keyboard focus and off screen; off for reduced motion.
  (() => {
    const root = document.getElementById('rr-look-{{ section.id }}');
    const track = root?.querySelector('.rr-look__track');
    if (!track || track.children.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    [...track.children].forEach((li) => {
      const c = li.cloneNode(true);
      c.setAttribute('aria-hidden', 'true');
      c.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
      track.appendChild(c);
    });
    track.style.scrollSnapType = 'none';
    const SPEED = {{ s.speed }};
    let paused = false, visible = true, last = 0, pos = track.scrollLeft;
    const half = () => track.scrollWidth / 2;
    const frame = (t) => {
      const dt = last ? Math.min(t - last, 50) : 16; last = t;
      if (!paused && visible && !document.hidden) {
        if (Math.abs(track.scrollLeft - pos) > 2) pos = track.scrollLeft;
        pos += SPEED * dt / 1000;
        if (pos >= half()) pos -= half();
        track.scrollLeft = pos;
      } else pos = track.scrollLeft;
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
    root.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') paused = true; });
    root.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { paused = false; pos = track.scrollLeft; } });
    track.addEventListener('touchstart', () => { paused = true; }, { passive: true });
    track.addEventListener('touchend', () => setTimeout(() => { paused = false; pos = track.scrollLeft; }, 2500), { passive: true });
    root.addEventListener('focusin', () => { paused = true; });
    root.addEventListener('focusout', () => { paused = false; });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(root);
  })();
</script>
{%- endif %}
{% schema %}
{
  "name": "RR: lookbook strip",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lookbook" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Photos", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop the collection" },
    { "type": "url", "id": "link", "label": "Link (leave empty for the collection)" },
    { "type": "checkbox", "id": "autoplay", "label": "Move on its own", "default": false },
    { "type": "range", "id": "speed", "label": "Speed (pixels per second)", "min": 20, "max": 200, "step": 10, "default": 90 }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "caption", "label": "Caption (on hover)" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "RR: lookbook strip" }]
}
{% endschema %}

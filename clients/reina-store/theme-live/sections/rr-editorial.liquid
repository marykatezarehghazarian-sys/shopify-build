{%- comment -%}
  Reina Reichouni editorial images (Toteme / Tove style). One block = full-width image,
  two = side by side, three = three across. Caption on the photo or underneath.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign n = section.blocks.size -%}
<section class="rr-ed rr-ed--{{ s.caption_style }}" id="rr-ed-{{ section.id }}" data-rr-effect="{{ s.scroll_effect | default: 'parallax' }}" style="--rr-ed-cols: {{ n | at_least: 1 }};">
  {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    <a class="rr-ed__item" href="{{ b.link | default: '#' }}" {{ block.shopify_attributes }}>
      <span class="rr-ed__media">
        {%- if b.image != blank -%}
          {%- capture sizes -%}{% if n == 1 %}100vw{% else %}(min-width: 750px) {{ 100 | divided_by: n }}vw, 100vw{% endif %}{%- endcapture -%}
          {{ b.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600, 2000, 2400', sizes: sizes, class: 'rr-ed__img', alt: b.image.alt, style: b.focal }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'rr-ed__img' }}
        {%- endif -%}
      </span>
      {%- if b.title != blank or b.link_label != blank -%}
        <span class="rr-ed__caption">
          {%- if b.title != blank %}<span class="rr-ed__title">{{ b.title | escape }}</span>{% endif -%}
          {%- if b.link_label != blank %}<span class="rr-ed__link">{{ b.link_label | escape }}</span>{% endif -%}
        </span>
      {%- endif -%}
    </a>
  {%- endfor -%}
</section>

<style>
  #rr-ed-{{ section.id }} { display: grid; grid-template-columns: repeat(var(--rr-ed-cols), minmax(0, 1fr)); gap: {{ s.gap }}px; padding: {{ s.padding_top }}px {% if s.full_width %}0{% else %}max(16px, 2.2vw){% endif %} {{ s.padding_bottom }}px; }
  {%- if s.max_width > 0 %}#rr-ed-{{ section.id }} { max-width: {{ s.max_width }}px; margin-inline: auto; box-sizing: content-box; }{% endif %}
  #rr-ed-{{ section.id }} .rr-ed__item { position: relative; display: block; color: var(--rr-ink); text-decoration: none; }
  #rr-ed-{{ section.id }} .rr-ed__media { position: relative; display: block; aspect-ratio: {{ s.ratio }}; overflow: hidden; background: var(--rr-surface); }
  #rr-ed-{{ section.id }} .rr-ed__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s cubic-bezier(.2, .7, .2, 1); }
  @media (hover: hover) { #rr-ed-{{ section.id }} .rr-ed__item:hover .rr-ed__img { transform: scale(1.03); } }
  #rr-ed-{{ section.id }} .rr-ed__caption { display: grid; justify-items: center; gap: 6px; text-align: center; }
  #rr-ed-{{ section.id }}.rr-ed--overlay .rr-ed__caption { position: absolute; left: 0; right: 0; bottom: clamp(20px, 5%, 48px); color: {{ s.caption_color }};{% if s.caption_color == '#ffffff' %} text-shadow: 0 1px 12px rgb(0 0 0 / .25);{% endif %} }
  #rr-ed-{{ section.id }}.rr-ed--below .rr-ed__caption { padding: 14px 8px 4px; }
  #rr-ed-{{ section.id }} .rr-ed__title { font-family: var(--rr-serif); font-size: clamp(1.15rem, 1.6vw, 1.5rem); font-weight: 400; line-height: 1.15; }
  #rr-ed-{{ section.id }} .rr-ed__link { font: 400 10.5px var(--rr-sans); letter-spacing: .14em; text-transform: uppercase; padding-bottom: 2px; border-bottom: 1px solid currentColor; }
  @media (max-width: 749px) {
    #rr-ed-{{ section.id }} { grid-template-columns: repeat({% if n > 2 %}1{% else %}{{ s.mobile_columns }}{% endif %}, minmax(0, 1fr)); }
    #rr-ed-{{ section.id }} .rr-ed__media { aspect-ratio: {{ s.ratio_mobile }}; }
  }
</style>

{% schema %}
{
  "name": "RR: editorial images",
  "class": "section-rr-editorial",
  "max_blocks": 3,
  "settings": [
    { "type": "select", "id": "caption_style", "label": "Caption", "default": "overlay", "options": [ { "value": "overlay", "label": "On the photo" }, { "value": "below", "label": "Under the photo" } ] },
    { "type": "color", "id": "caption_color", "label": "Caption colour on the photo", "default": "#ffffff" },
    { "type": "select", "id": "scroll_effect", "label": "Photo motion on scroll", "default": "parallax", "info": "Scroll zoom: photos start slightly enlarged and settle to full frame as they reach the middle of the screen. Off for visitors who prefer reduced motion.", "options": [ { "value": "none", "label": "None" }, { "value": "parallax", "label": "Subtle parallax" }, { "value": "zoom", "label": "Scroll zoom" } ] },
    { "type": "text", "id": "ratio", "label": "Photo shape on desktop (CSS aspect-ratio)", "default": "3 / 4" },
    { "type": "text", "id": "ratio_mobile", "label": "Photo shape on phones", "default": "3 / 4" },
    { "type": "select", "id": "mobile_columns", "label": "Columns on phones", "default": "1", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ] },
    { "type": "checkbox", "id": "full_width", "label": "Edge to edge", "default": true },
    { "type": "range", "id": "max_width", "label": "Max width on desktop (0 = full)", "min": 0, "max": 1600, "step": 50, "unit": "px", "default": 0 },
    { "type": "range", "id": "gap", "label": "Gap", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 6 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    { "type": "image", "name": "Image", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "focal", "label": "Image position (CSS, e.g. object-position: center top)" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "RR: editorial images", "blocks": [{ "type": "image" }, { "type": "image" }] }]
}
{% endschema %}

{%- comment -%}
  Reina Reichouni footer, rebuilt from the original site:
  newsletter on the left, two link columns, the large "REINA REICHOUNI" wordmark, then the credit line.
{%- endcomment -%}
{%- assign s = section.settings -%}
<footer class="rr-footer" id="rr-footer-{{ section.id }}">
  <div class="rr-footer__top">
    <div class="rr-footer__signup">
      <h2 class="rr-footer__heading">{{ s.heading | escape }}</h2>
      {%- if s.offer != blank %}<p class="rr-footer__offer">{{ s.offer | escape }}</p>{% endif -%}
      {%- form 'customer', id: 'rr-footer-signup', class: 'rr-footer__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="rr-footer__ok" role="status">{{ s.success | escape }}</p>
        {%- else -%}
          <label class="rr-footer__label visually-hidden" for="rr-footer-email">Email</label>
          <div class="rr-footer__field">
            <input id="rr-footer-email" type="email" name="contact[email]" placeholder="Email" required autocomplete="email" aria-required="true">
            <button type="submit" class="rr-footer__submit" aria-label="Subscribe">&rarr;</button>
          </div>
          {%- if form.errors -%}<p class="rr-footer__err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
      <p class="rr-footer__legal">{{ s.disclaimer | escape }}</p>
    </div>
    {%- for key in (1..2) -%}
      {%- assign menu_key = 'menu_' | append: key -%}
      {%- assign menu = linklists[s[menu_key]] -%}
      {%- if menu.links.size > 0 -%}
        <ul class="rr-footer__links" role="list">
          {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if s.wordmark_1 != blank or s.wordmark_2 != blank -%}
    <a class="rr-footer__wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if s.wordmark_1 != blank -%}{{ s.wordmark_1 | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'rr-footer__wm rr-footer__wm--1', alt: '' }}{%- endif -%}
      {%- if s.wordmark_2 != blank -%}{{ s.wordmark_2 | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'rr-footer__wm rr-footer__wm--2', alt: '' }}{%- endif -%}
    </a>
  {%- endif -%}
  {%- if s.contact != blank %}<div class="rr-footer__contact">{{ s.contact }}</div>{% endif -%}
  <p class="rr-footer__credit">
    {%- if s.credit_link != blank -%}<a href="{{ s.credit_link }}" target="_blank" rel="noopener">{{ s.credit | escape }}</a>{%- else -%}{{ s.credit | escape }}{%- endif -%}
  </p>
</footer>

<style>
  #rr-footer-{{ section.id }} { color: var(--rr-ink, #642226); background: transparent; padding: 72px max(16px, 5vw) 28px; overflow: hidden; }
  #rr-footer-{{ section.id }} .rr-footer__top { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr) minmax(0, .9fr); gap: 32px; max-width: 1020px; margin: 0 auto; align-items: start; }
  #rr-footer-{{ section.id }} .rr-footer__heading { margin: 0 0 18px; font-family: var(--rr-aboreto); font-weight: 400; font-size: clamp(1.4rem, 2.1vw, 1.875rem); line-height: 1.1; color: inherit; text-transform: uppercase; }
  #rr-footer-{{ section.id }} .rr-footer__offer { margin: -6px 0 14px; font: 300 13px var(--rr-sans); }
  #rr-footer-{{ section.id }} .rr-footer__contact { text-align: center; margin: 0 0 10px; font: 300 13px var(--rr-sans); letter-spacing: .04em; }
  #rr-footer-{{ section.id }} .rr-footer__contact a { color: inherit; text-decoration: none; }
  #rr-footer-{{ section.id }} .rr-footer__contact a:hover { text-decoration: underline; }
  #rr-footer-{{ section.id }} .rr-footer__label { display: block; font-family: var(--rr-sans); font-size: 12px; font-weight: 400; }
  #rr-footer-{{ section.id }} .rr-footer__field { display: flex; border-bottom: 1px solid currentColor; max-width: 340px; }
  #rr-footer-{{ section.id }} .rr-footer__field input { flex: 1; min-width: 0; border: 0; background: none; padding: 8px 12px; font: 400 15px var(--rr-sans); color: inherit; outline-offset: 2px; }
  #rr-footer-{{ section.id }} .rr-footer__field input::placeholder { color: inherit; opacity: 1; }
  #rr-footer-{{ section.id }} .rr-footer__submit { border: 0; background: none; color: inherit; cursor: pointer; padding: 0 2px; font-size: 14px; }
  #rr-footer-{{ section.id }} .rr-footer__legal { max-width: 340px; margin: 10px 0 0; font: 400 8px/1.5 var(--rr-sans); }
  #rr-footer-{{ section.id }} .rr-footer__ok, #rr-footer-{{ section.id }} .rr-footer__err { font: 400 12px var(--rr-sans); margin: 6px 0 0; }
  #rr-footer-{{ section.id }} .rr-footer__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
  #rr-footer-{{ section.id }} .rr-footer__links a { font: 300 13px var(--rr-sans); letter-spacing: .01em; text-transform: uppercase; color: inherit; text-decoration: none; }
  #rr-footer-{{ section.id }} .rr-footer__links a:hover { text-decoration: underline; }
  #rr-footer-{{ section.id }} .rr-footer__wordmark { display: flex; align-items: flex-end; justify-content: center; width: min(100%, 1306px); margin: 48px auto 14px; }
  #rr-footer-{{ section.id }} .rr-footer__wm { display: block; height: auto; flex: none; max-width: none; }
  #rr-footer-{{ section.id }} .rr-footer__wm--1 { width: 36.4%; }
  #rr-footer-{{ section.id }} .rr-footer__wm--2 { width: 64.9%; margin-inline-start: -1.3%; }
  #rr-footer-{{ section.id }} .rr-footer__credit { margin: 0; text-align: center; font: 200 14px var(--rr-sans); }
  #rr-footer-{{ section.id }} .rr-footer__credit a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 749px) {
    #rr-footer-{{ section.id }} { padding-top: 48px; }
    #rr-footer-{{ section.id }} .rr-footer__top { grid-template-columns: 1fr 1fr; }
    #rr-footer-{{ section.id }} .rr-footer__signup { grid-column: 1 / -1; }
    #rr-footer-{{ section.id }} .rr-footer__links { gap: 14px; }
    #rr-footer-{{ section.id }} .rr-footer__links a { font-size: 11px; }
    #rr-footer-{{ section.id }} .rr-footer__wordmark { margin-top: 40px; }
    #rr-footer-{{ section.id }} .rr-footer__credit { font-size: 10px; }
  }
</style>

{% schema %}
{
  "name": "RR: footer",
  "class": "section-rr-footer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Newsletter heading", "default": "Sign up for updates" },
    { "type": "text", "id": "offer", "label": "Offer line under the heading" },
    { "type": "text", "id": "disclaimer", "label": "Newsletter small print", "default": "By entering the email address above you agree to receive marketing messages from ReinaReichouni and agree to our terms and services and privacy policy." },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "Thanks for subscribing!" },
    { "type": "link_list", "id": "menu_1", "label": "Links column 1", "default": "footer" },
    { "type": "link_list", "id": "menu_2", "label": "Links column 2" },
    { "type": "image_picker", "id": "wordmark_1", "label": "Wordmark, first word" },
    { "type": "image_picker", "id": "wordmark_2", "label": "Wordmark, second word" },
    { "type": "richtext", "id": "contact", "label": "Contact line (above the credit)" },
    { "type": "text", "id": "credit", "label": "Credit line", "default": "© 2026 REINAREICHOUNI | All Rights Reserved | Designed by The Virtual Stylist" },
    { "type": "url", "id": "credit_link", "label": "Credit line link" }
  ]
}
{% endschema %}

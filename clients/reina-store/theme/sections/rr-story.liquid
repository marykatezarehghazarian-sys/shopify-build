{%- comment -%}
  Reina Reichouni brand story: a tall photo beside a large serif statement and the founding text,
  with a link to the About page. Text comes from the About page.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="rr-story" id="rr-story-{{ section.id }}">
  <div class="rr-story__media">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 750px) 45vw, 100vw', class: 'rr-story__img', alt: s.image.alt }}
    {%- endif -%}
  </div>
  <div class="rr-story__text">
    {%- if s.eyebrow != blank %}<p class="rr-story__eyebrow">{{ s.eyebrow | escape }}</p>{% endif -%}
    {%- if s.heading != blank %}<h2 class="rr-story__heading">{{ s.heading | escape }}</h2>{% endif -%}
    {%- if s.text != blank %}<div class="rr-story__body">{{ s.text }}</div>{% endif -%}
    {%- if s.link_label != blank %}<a class="rr-story__link" href="{{ s.link | default: '/pages/aboutus' }}">{{ s.link_label | escape }}</a>{% endif -%}
  </div>
</section>
<style>
  #rr-story-{{ section.id }} { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(28px, 6vw, 110px); align-items: center; padding: var(--rr-space-9) max(16px, 4vw); color: var(--rr-ink); }
  #rr-story-{{ section.id }} .rr-story__media { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--rr-surface); }
  #rr-story-{{ section.id }} .rr-story__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #rr-story-{{ section.id }} .rr-story__eyebrow { margin: 0 0 var(--rr-space-5); font: 400 var(--rr-text-xs) var(--rr-sans); letter-spacing: .2em; text-transform: uppercase; opacity: .75; }
  #rr-story-{{ section.id }} .rr-story__heading { margin: 0 0 var(--rr-space-6); max-width: 15ch; font-family: var(--rr-serif); font-weight: 300; font-size: var(--rr-display-lg); line-height: .98; letter-spacing: -.01em; color: inherit; text-wrap: balance; }
  #rr-story-{{ section.id }} .rr-story__body { max-width: 46ch; font: 300 var(--rr-text-md)/1.85 var(--rr-sans); opacity: .9; }
  #rr-story-{{ section.id }} .rr-story__body p { margin: 0 0 1.1em; }
  #rr-story-{{ section.id }} .rr-story__link { display: inline-block; margin-top: var(--rr-space-4); font: 400 var(--rr-text-xs) var(--rr-sans); letter-spacing: .16em; text-transform: uppercase; color: inherit; text-decoration: none; padding-bottom: 3px; border-bottom: 1px solid currentColor; }
  @media (max-width: 749px) { #rr-story-{{ section.id }} { grid-template-columns: 1fr; padding-block: var(--rr-space-8); } }
</style>
{% schema %}
{
  "name": "RR: brand story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The house" },
    { "type": "text", "id": "heading", "label": "Statement" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "About us" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "RR: brand story" }]
}
{% endschema %}

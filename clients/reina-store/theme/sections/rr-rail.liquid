{%- comment -%}
  Reina Reichouni product rail ("New Arrivals" in the Khaite style): italic serif heading,
  "View all" link, a row of cards that scrolls sideways with arrows on desktop and swipe on phones.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign c = s.collection -%}
<section class="rr-rail rr-rail--{{ s.layout }}" id="rr-rail-{{ section.id }}">
  <div class="rr-rail__head">
    {%- if s.heading != blank %}<h2 class="rr-rail__heading">{{ s.heading | escape }}</h2>{% endif -%}
    <div class="rr-rail__tools">
      {%- if c != blank and s.link_label != blank %}<a class="rr-rail__all" href="{{ c.url }}">{{ s.link_label | escape }}</a>{% endif -%}
      <button type="button" class="rr-rail__arrow" data-dir="-1" aria-label="Previous"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button>
      <button type="button" class="rr-rail__arrow" data-dir="1" aria-label="Next"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
    </div>
  </div>
  <ul class="rr-rail__track" role="list">
    {%- if c != blank -%}
      {%- for product in c.products limit: s.limit -%}
        <li class="rr-rail__item">{% render 'rr-card', product: product, sizes: '(min-width: 990px) 25vw, (min-width: 750px) 40vw, 70vw' %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}<li class="rr-rail__item"><div class="rr-card"><div class="rr-card__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'rr-card__img' }}</div></div></li>{%- endfor -%}
    {%- endif -%}
  </ul>
</section>

<style>
  #rr-rail-{{ section.id }} { padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px; }
  #rr-rail-{{ section.id }} .rr-rail__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; padding: 0 max(16px, 2.2vw) 18px; }
  #rr-rail-{{ section.id }} .rr-rail__heading { margin: 0; font-family: var(--rr-serif); font-style: italic; font-weight: 400; font-size: clamp(1.4rem, 2vw, 1.75rem); color: var(--rr-ink); }
  #rr-rail-{{ section.id }} .rr-rail__tools { display: flex; align-items: center; gap: 10px; }
  #rr-rail-{{ section.id }} .rr-rail__all { font: 400 11px var(--rr-sans); letter-spacing: .12em; text-transform: uppercase; color: var(--rr-ink); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; margin-inline-end: 6px; }
  #rr-rail-{{ section.id }} .rr-rail__arrow { display: grid; place-items: center; width: 32px; height: 32px; border: 0; background: none; color: var(--rr-ink); cursor: pointer; }
  #rr-rail-{{ section.id }} .rr-rail__arrow:disabled { opacity: .3; cursor: default; }
  #rr-rail-{{ section.id }} .rr-rail__track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 3 * 6px - 2 * max(16px, 2.2vw)) / 4); gap: 6px; margin: 0; padding: 0 max(16px, 2.2vw); list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: max(16px, 2.2vw); scrollbar-width: none; overscroll-behavior-x: contain; }
  #rr-rail-{{ section.id }} .rr-rail__track::-webkit-scrollbar { display: none; }
  #rr-rail-{{ section.id }} .rr-rail__item { scroll-snap-align: start; min-width: 0; }
  #rr-rail-{{ section.id }}.rr-rail--grid .rr-rail__track { grid-auto-flow: row; grid-template-columns: repeat({{ s.columns }}, minmax(0, 1fr)); row-gap: 28px; overflow: visible; }
  #rr-rail-{{ section.id }}.rr-rail--grid .rr-rail__arrow { display: none; }
  #rr-rail-{{ section.id }}.rr-rail--grid .rr-rail__head { justify-content: center; flex-direction: column; align-items: center; gap: 10px; }
  @media (max-width: 989px) { #rr-rail-{{ section.id }} .rr-rail__track { grid-auto-columns: 42%; } #rr-rail-{{ section.id }}.rr-rail--grid .rr-rail__track { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 749px) {
    #rr-rail-{{ section.id }} .rr-rail__track { grid-auto-columns: 68%; }
    #rr-rail-{{ section.id }} .rr-rail__arrow { display: none; }
  }
</style>
<script>
  (() => {
    const root = document.getElementById('rr-rail-{{ section.id }}');
    if (!root) return;
    const track = root.querySelector('.rr-rail__track');
    const [prev, next] = root.querySelectorAll('.rr-rail__arrow');
    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    root.querySelectorAll('.rr-rail__arrow').forEach((b) => b.addEventListener('click', () => {
      const item = track.querySelector('.rr-rail__item');
      track.scrollBy({ left: Number(b.dataset.dir) * (item ? item.getBoundingClientRect().width + 6 : track.clientWidth), behavior: 'smooth' });
    }));
    track.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();

    // Autoplay: the row glides continuously from the moment the page opens and loops seamlessly
    // (the pieces are repeated once behind the scenes). Pauses while the visitor hovers, touches or
    // tabs into the row and while it's off screen; never runs for reduced motion.
    {%- if s.autoplay and s.layout == 'rail' %}
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && track.children.length > 1) {
      [...track.children].forEach((li) => {
        const c = li.cloneNode(true);
        c.setAttribute('aria-hidden', 'true');
        c.querySelectorAll('a, button').forEach((el) => el.setAttribute('tabindex', '-1'));
        track.appendChild(c);
      });
      track.style.scrollSnapType = 'none';
      const SPEED = {{ s.speed }}; // pixels per second
      let paused = false, visible = true, last = 0, pos = track.scrollLeft;
      const half = () => track.scrollWidth / 2;
      const frame = (t) => {
        const dt = last ? Math.min(t - last, 50) : 16; last = t;
        if (!paused && visible && !document.hidden) {
          if (Math.abs(track.scrollLeft - pos) > 2) pos = track.scrollLeft; // visitor swiped or used arrows
          pos += SPEED * dt / 1000;
          if (pos >= half()) pos -= half();
          track.scrollLeft = pos;
        } else pos = track.scrollLeft;
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
      const pause = () => { paused = true; };
      const resume = () => { paused = false; pos = track.scrollLeft; };
      root.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') pause(); });
      root.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') resume(); });
      track.addEventListener('touchstart', pause, { passive: true });
      track.addEventListener('touchend', () => setTimeout(resume, 2500), { passive: true });
      root.addEventListener('focusin', pause);
      root.addEventListener('focusout', resume);
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(root);
      // Arrows keep working: wrap round instead of stopping at the ends.
      next.disabled = prev.disabled = false;
      track.removeEventListener('scroll', update);
    }
    {%- endif %}
  })();
</script>

{% schema %}
{
  "name": "RR: product rail",
  "class": "section-rr-rail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "rail", "options": [ { "value": "rail", "label": "Sliding row" }, { "value": "grid", "label": "Grid" } ] },
    { "type": "range", "id": "columns", "label": "Grid columns on desktop", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 30, "step": 1, "default": 12 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "checkbox", "id": "autoplay", "label": "Move on its own (sliding row)", "default": false },
    { "type": "range", "id": "speed", "label": "Speed (pixels per second)", "min": 20, "max": 200, "step": 10, "default": 90 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "RR: product rail" }]
}
{% endschema %}

{%- comment -%}
  Reina Reichouni text page (About us): the page content, centred in a narrow column, light type.
{%- endcomment -%}
<section class="rr-text rr-text--{{ section.settings.align }}" id="rr-text-{{ section.id }}">
  {%- if section.settings.show_title %}<h1 class="rr-text__title">{{ page.title | escape }}</h1>{% endif -%}
  <div class="rr-text__body">{{ page.content }}</div>
</section>
<style>
  #rr-text-{{ section.id }} { max-width: 760px; margin: 0 auto; padding: clamp(64px, 10vw, 140px) 20px; color: var(--rr-ink); text-align: center; }
  #rr-text-{{ section.id }} .rr-text__title { margin: 0 0 36px; font-family: var(--rr-serif); font-weight: 400; font-size: clamp(1.8rem, 3vw, 2.4rem); letter-spacing: .04em; text-transform: uppercase; color: inherit; }
  #rr-text-{{ section.id }} .rr-text__body p { margin: 0 0 1.6em; font: 200 clamp(16px, 1.4vw, 18px)/1.8 var(--rr-sans); }
  #rr-text-{{ section.id }}.rr-text--left { text-align: left; }
  #rr-text-{{ section.id }}.rr-text--left .rr-text__title { text-align: center; }
  #rr-text-{{ section.id }}.rr-text--left .rr-text__body :is(p, li) { font: 300 14px/1.75 var(--rr-sans); margin: 0 0 1em; }
  #rr-text-{{ section.id }}.rr-text--left .rr-text__body h2 { margin: 2em 0 .6em; font-family: var(--rr-serif); font-weight: 400; font-size: 1.35rem; color: inherit; }
  #rr-text-{{ section.id }}.rr-text--left .rr-text__body ul { padding-inline-start: 1.2em; margin: 0 0 1em; }
</style>
{% schema %}
{ "name": "RR: page text", "settings": [ { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true }, { "type": "select", "id": "align", "label": "Text alignment", "default": "center", "options": [ { "value": "center", "label": "Centred" }, { "value": "left", "label": "Left (long text)" } ] } ], "presets": [{ "name": "RR: page text" }] }
{% endschema %}
